  <main id="contenido"><slot /></main>
  <footer class="footer"><div class="container footer-grid"><div class="footer-main"><a class="brand" href="/"><span class="brand-mark">J</span><span><b>JEFQ</b><small>CONSULTOR</small></span></a><p>Ciberseguridad práctica, controlada y comprensible para organizaciones colombianas.</p><a class="footer-cta" href="#" data-wa-modal data-wa-message="Hola Jaime, quiero solicitar una valoración inicial de ciberseguridad.">Solicitar valoración</a></div><div><h2>Servicios</h2><a href="/servicios/diagnostico-seguridad">Diagnóstico</a><a href="/servicios/hardening">Hardening</a><a href="/servicios/pruebas-autorizadas">Pruebas autorizadas</a><a href="/servicios/informes-tecnicos">Informes</a><a href="/seguridad-inteligencia-artificial">Seguridad para IA</a></div><div><h2>Legal</h2><a href="/privacidad">Privacidad</a><a href="/terminos">Términos</a><a href="/tratamiento-datos">Datos personales</a></div><div><h2>Contacto</h2><a href="#" data-wa-modal>WhatsApp: @JaimeByte</a><a href="mailto:jaimeforeroquintero@gmail.com">jaimeforeroquintero@gmail.com</a><p>Bogotá y toda Colombia · Atención 24/7</p></div></div>      <div class="container footer-trust-access">
        <div><strong>Atención directa</strong><span>Comunicación con el responsable del servicio.</span></div>
        <div><strong>Intervenciones autorizadas</strong><span>Alcance y límites definidos previamente.</span></div>
        <div><strong>Resultados documentados</strong><span>Prioridades, recomendaciones y próximos pasos.</span></div>
        <nav aria-label="Accesos de confianza"><a href="/quien-soy">Quién soy</a><a href="/diagnostico-seguridad-bogota">Diagnóstico en Bogotá</a><a href="/consultoria-ciberseguridad-colombia">Consultoría en Colombia</a><a href="/como-trabajamos">Cómo trabajamos</a><a href="/informe-demostrativo">Informe demostrativo</a><a href="/blog">Blog</a><a href="/preguntas-frecuentes">FAQ</a>
          <a href="/seguridad-autorizacion-alcance">Autorización y alcance</a></nav>
      </div>
<div class="container footer-bottom"><span>© {new Date().getFullYear()} JEFQ Consultor</span><span>Pruebas únicamente con autorización escrita.</span></div>  <!-- JEFQ-SEO-AUTHORITY-LINKS -->
  <div class="authority-links">
    <div class="container">
      <nav aria-label="Recursos y confianza">
        <a href="/recursos">Centro de recursos</a>
        <a href="/informe-demostrativo">Informe demostrativo</a>
        <a href="/recursos/checklist-seguridad-pyme">Checklist para pymes</a>
        <a href="/seguridad-autorizacion-alcance">Autorización y alcance</a>
        <a href="/preguntas-frecuentes">Preguntas frecuentes</a>
        <a href="/valoracion">Solicitar valoración</a>
      </nav>
    </div>
  </div>
</footer>
  <a class="whatsapp" href="#" data-wa-modal data-wa-message="Hola Jaime, quiero solicitar una valoración inicial de ciberseguridad." aria-label="Contactar por WhatsApp"><span>WA</span><b>Solicitar valoración</b></a>
  <AsistenteIA />
  <WhatsAppModal />
  <script>
    const b=document.querySelector('.menu-button'); const m=document.querySelector('.menu');
    b?.addEventListener('click',()=>{const o=m?.classList.toggle('menu-open');b.setAttribute('aria-expanded',String(Boolean(o)));});
    m?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{m.classList.remove('menu-open');b?.setAttribute('aria-expanded','false');}));
    const nodes=document.querySelectorAll('[data-reveal]');
    if('IntersectionObserver' in window){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}}),{threshold:.09});nodes.forEach(n=>io.observe(n));}else{nodes.forEach(n=>n.classList.add('visible'));}
  </script>
<!-- JEFQ-AUTORIDAD-REAL-V1 -->
<script defer src="/_vercel/insights/script.js"></script>
<script defer src="/jefq-events.js"></script>
<!-- Sentry cliente (solo errores). DSN desde variable de entorno de Vercel
     (PUBLIC_SENTRY_DSN); sin ella o si falla, no hace nada: la página abre igual. -->
<script src="https://browser.sentry-cdn.com/11.8.0/bundle.min.js" crossorigin="anonymous"></script>
<script define:vars={{ sentryDsn: import.meta.env.PUBLIC_SENTRY_DSN }}>
  try {
    if (sentryDsn && window.Sentry) {
      window.Sentry.init({
        dsn: sentryDsn,
        sendDefaultPii: false,
        tracesSampleRate: 0,
        beforeSend: function (event) {
          if (event.request) {
            delete event.request.data;
            delete event.request.cookies;
          }
          return event;
        },
      });
    }
  } catch (e) {
    /* Sentry es opcional: un fallo aquí jamás tumba la página. */
  }
</script>
<!-- PostHog: mapa de visitantes (solo JEFQ). Sin clave en Vercel = no hace nada. -->
<script define:vars={{ posthogKey }}>
(function () {
  try {
    var key = String(posthogKey || "").trim();
    if (!key || key.indexOf("phc_") !== 0) return;
    var hn = location.hostname;
    if (hn === "localhost" || hn === "127.0.0.1") return;
    /* Snippet oficial de PostHog (stub con cola: si array.js no carga, las
       llamadas se encolan y la página sigue funcionando igual). */
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],Object.defineProperty(u,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e}}),Object.defineProperty(u.people,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(){return u.toString(1)+".people (stub)"}}),o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagResult isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
    window.posthog.init(key, {
      api_host: "https://us.i.posthog.com",
      defaults: "2026-05-30",
      autocapture: false,            /* solo los 3 eventos explícitos de abajo */
      capture_pageview: true,        /* $pageview automático */
      disable_session_recording: true /* sin grabaciones de sesión */
    });
    function cap(name, props) {
      try { if (window.posthog && window.posthog.capture) window.posthog.capture(name, props || {}); } catch (e) {}
    }
    /* Delegado único: no se toca el marcado de CTAs ni de planes. */
    document.addEventListener("click", function (ev) {
      var t = ev.target && ev.target.closest ? ev.target.closest("a,button") : null;
      if (!t) return;
      if (t.closest("[data-wa-modal]")) {
        /* Intención de escribir por WhatsApp (el número nunca sale del servidor). */
        cap("cta_whatsapp_click", { path: location.pathname });
      } else if (t.classList && t.classList.contains("pay-plan")) {
        cap("plan_button_click", { path: location.pathname, plan: t.getAttribute("data-producto") || "desconocido" });
      }
    });
  } catch (e) { /* PostHog jamás debe romper la página */ }
})();
</script>
<Analytics />
</body>
</html>