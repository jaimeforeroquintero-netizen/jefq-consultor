---
import "../styles/global.css";
import AsistenteIA from "../components/AsistenteIA.astro";
import WhatsAppModal from "../components/WhatsAppModal.astro";
import "../styles/seo-authority.css";
import "../styles/service-premium-v2.css";
import "../styles/conversion-evidence.css";
import "../styles/authority-premium-v3.css";
import Analytics from "@vercel/analytics/astro";
import "../styles/trust-commercial.css";

import "../styles/service-links.css";
import "../styles/services-premium.css";
import "../styles/marketing-conversion.css";
import "../styles/color-fix-v1.css";
interface Props { title:string; description:string; canonicalPath?:string; noindex?:boolean; }
const { title, description, canonicalPath = Astro.url.pathname, noindex = false } = Astro.props;
const baseUrl = "https://jefq-consultor.pages.dev";
const canonical = new URL(canonicalPath, baseUrl).toString();
const waMessage = "Hola Jaime, quiero información sobre los servicios de ciberseguridad de JEFQ Consultor.";
// PostHog (mapa de visitantes): la clave vive en la variable de entorno
// PUBLIC_POSTHOG_KEY de Vercel, NUNCA en el código. Sin clave = no se inicializa.
const posthogKey = (import.meta.env.PUBLIC_POSTHOG_KEY || "").trim();
// GEO/LLM: grafo schema.org para descubrimiento por buscadores e IAs.
// Organization (identidad), WebSite y ProfessionalService (oferta con planes).
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": baseUrl + "/#organizacion",
      "name": "JEFQ Consultor",
      "url": baseUrl,
      "logo": baseUrl + "/og-image.png",
      "sameAs": ["https://x.com/JaimeByte"],
      "founder": { "@type": "Person", "name": "Jaime Forero" },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "jaimeforeroquintero@gmail.com",
        "contactType": "sales",
        "areaServed": "CO",
        "availableLanguage": "es"
      }
    },
    {
      "@type": "WebSite",
      "@id": baseUrl + "/#sitio",
      "url": baseUrl,
      "name": "JEFQ Consultor",
      "inLanguage": "es-CO",
      "publisher": { "@id": baseUrl + "/#organizacion" }
    },
    {
      "@type": "ProfessionalService",
      "@id": baseUrl + "/#servicio",
      "name": "JEFQ Consultor",
      "url": baseUrl,
      "description": description,
      "founder": { "@type": "Person", "name": "Jaime Forero" },
      "areaServed": { "@type": "Country", "name": "Colombia" },
      "address": { "@type": "PostalAddress", "addressLocality": "Bogotá", "addressCountry": "CO" },
      "openingHours": "Mo-Su 00:00-23:59",
      "priceRange": "$$",
      "makesOffer": [
        {
          "@type": "Offer",
          "name": "Plan Esencial",
          "price": "390000",
          "priceCurrency": "COP",
          "description": "Diagnóstico de ciberseguridad para pymes en Colombia."
        },
        {
          "@type": "Offer",
          "name": "Plan Pyme",
          "price": "890000",
          "priceCurrency": "COP",
          "description": "Diagnóstico ampliado con priorización y acompañamiento."
        },
        {
          "@type": "Offer",
          "name": "Plan Integral",
          "price": "1790000",
          "priceCurrency": "COP",
          "description": "Cobertura integral: diagnóstico, pruebas autorizadas, hardening e informes."
        }
      ]
    }
  ]
};
import "../styles/evidencia-premium.css";
import "../styles/audit-v2-fixes.css";
import "../styles/authority-real-v1.css";
import "../styles/commercial-v1.css";
import "../styles/jefq-diseno-hibrido-v1.css";
---
<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#050b16" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large"} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:site_name" content="JEFQ Consultor" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og-image.png', baseUrl).toString()} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={new URL('/og-image.png', baseUrl).toString()} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script src="https://checkout.wompi.co/widget.js"></script>
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <div class="topbar"><div class="container topbar-inner"><span>Bogotá y toda Colombia</span><span>Atención remota 24/7</span><span>WhatsApp: <b>@JaimeByte</b></span></div></div>
  <header class="header">
    <div class="container nav">
      <a class="brand" href="/" aria-label="JEFQ Consultor, inicio"><span class="brand-mark">J</span><span><b>JEFQ</b><small>CONSULTOR</small></span></a>
      <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false"><i></i><i></i><i></i></button>
      <nav class="menu" aria-label="Navegación principal"><a href="/#servicios">Servicios</a><a href="/#metodologia">Metodología</a><a href="/#planes">Planes</a><a href="/#evidencia">Evidencia</a><a class="nav-cta" href="#" data-wa-modal data-wa-message="Hola Jaime, quiero solicitar una valoración inicial de ciberseguridad.">Solicitar valoración</a>          <a href="/quien-soy">Quién soy</a>
          <a href="/blog">Blog</a>
          <a href="/preguntas-frecuentes">FAQ</a>
          <a href="/seguridad-autorizacion-alcance">Autorización y alcance</a>
