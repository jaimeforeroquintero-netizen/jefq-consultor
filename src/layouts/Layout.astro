---
import "../styles/global.css";
import AsistenteIA from "../components/AsistenteIA.astro";
import WhatsAppModal from "../components/WhatsAppModal.astro";
import "../styles/seo-authority.css";
import "../styles/service-premium-v2.css";
import "../styles/conversion-evidence.css";
import "../styles/authority-premium-v3.css";
import { Analytics } from "@vercel/analytics/astro";
import "../styles/trust-commercial.css";

import "../styles/service-links.css";
import "../styles/services-premium.css";
import "../styles/marketing-conversion.css";
interface Props { title:string; description:string; canonicalPath?:string; noindex?:boolean; }
const { title, description, canonicalPath = Astro.url.pathname, noindex = false } = Astro.props;
const baseUrl = "https://jefq-consultor.vercel.app";
const canonical = new URL(canonicalPath, baseUrl).toString();
const waMessage = "Hola Jaime, quiero información sobre los servicios de ciberseguridad de JEFQ Consultor.";
const schema = {
  "@context":"https://schema.org", "@type":"ProfessionalService",
  name:"JEFQ Consultor", url:baseUrl,
  founder:{"@type":"Person",name:"Jaime Forero"},
  areaServed:{"@type":"Country",name:"Colombia"},
  address:{"@type":"PostalAddress",addressLocality:"Bogotá",addressCountry:"CO"},
  description, openingHours:"Mo-Su 00:00-23:59", priceRange:"$$"
};
import "../styles/evidencia-premium.css";
import "../styles/audit-v2-fixes.css";
import "../styles/authority-real-v1.css";
import "../styles/commercial-v1.css";
import "../styles/jefq-diseno-hibrido-v1.css";
---
<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#050b16" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large"} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:site_name" content="JEFQ Consultor" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og-image.png', baseUrl).toString()} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={new URL('/og-image.png', baseUrl).toString()} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script src="https://checkout.wompi.co/widget.js"></script>
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <div class="topbar"><div class="container topbar-inner"><span>Bogotá y toda Colombia</span><span>Atención remota 24/7</span><span>WhatsApp: <b>@JaimeByte</b></span></div></div>
  <header class="header">
    <div class="container nav">
      <a class="brand" href="/" aria-label="JEFQ Consultor, inicio"><span class="brand-mark">J</span><span><b>JEFQ</b><small>CONSULTOR</small></span></a>
      <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false"><i></i><i></i><i></i></button>
      <nav class="menu" aria-label="Navegación principal"><a href="/#servicios">Servicios</a><a href="/#metodologia">Metodología</a><a href="/#planes">Planes</a><a href="/#casos">Ejemplos de intervención</a><a class="nav-cta" href="#" data-wa-modal data-wa-message="Hola Jaime, quiero solicitar una valoración inicial de ciberseguridad.">Solicitar valoración</a>          <a href="/quien-soy">Quién soy</a>
          <a href="/blog">Blog</a>
          <a href="/preguntas-frecuentes">FAQ</a>
          <a href="/seguridad-autorizacion-alcance">Autorización y alcance</a>
        <a href="/recursos">Recursos</a>
        <a href="/orientacion-de-servicios">Elegir servicio</a>
        <a href="/valoracion">Valoración en línea</a>
</nav>
    </div>
  </header>
  <main id="contenido"><slot /></main>
  <footer class="footer"><div class="container footer-grid"><div class="footer-main"><a class="brand" href="/"><span class="brand-mark">J</span><span><b>JEFQ</b><small>CONSULTOR</small></span></a><p>Ciberseguridad práctica, controlada y comprensible para organizaciones colombianas.</p><a class="footer-cta" href="#" data-wa-modal data-wa-message="Hola Jaime, quiero solicitar una valoración inicial de ciberseguridad.">Solicitar valoración</a></div><div><h2>Servicios</h2><a href="/servicios/diagnostico-seguridad">Diagnóstico</a><a href="/servicios/hardening">Hardening</a><a href="/servicios/pruebas-autorizadas">Pruebas autorizadas</a><a href="/servicios/informes-tecnicos">Informes</a><a href="/seguridad-inteligencia-artificial">Seguridad para IA</a></div><div><h2>Legal</h2><a href="/privacidad">Privacidad</a><a href="/terminos">Términos</a><a href="/tratamiento-datos">Datos personales</a></div><div><h2>Contacto</h2><a href="#" data-wa-modal>WhatsApp: @JaimeByte</a><a href="mailto:jaimeforeroquintero@gmail.com">jaimeforeroquintero@gmail.com</a><p>Bogotá y toda Colombia · Atención 24/7</p></div></div>      <div class="container footer-trust-access">
        <div><strong>Atención directa</strong><span>Comunicación con el responsable del servicio.</span></div>
        <div><strong>Intervenciones autorizadas</strong><span>Alcance y límites definidos previamente.</span></div>
        <div><strong>Resultados documentados</strong><span>Prioridades, recomendaciones y próximos pasos.</span></div>
        <nav aria-label="Accesos de confianza"><a href="/quien-soy">Quién soy</a><a href="/diagnostico-seguridad-bogota">Diagnóstico en Bogotá</a><a href="/consultoria-ciberseguridad-colombia">Consultoría en Colombia</a><a href="/como-trabajamos">Cómo trabajamos</a><a href="/informe-demostrativo">Informe demostrativo</a><a href="/blog">Blog</a><a href="/preguntas-frecuentes">FAQ</a>
          <a href="/seguridad-autorizacion-alcance">Autorización y alcance</a></nav>
      </div>
<div class="container footer-bottom"><span>© {new Date().getFullYear()} JEFQ Consultor</span><span>Pruebas únicamente con autorización escrita.</span></div>  <!-- JEFQ-SEO-AUTHORITY-LINKS -->
  <div class="authority-links">
    <div class="container">
      <nav aria-label="Recursos y confianza">
        <a href="/recursos">Centro de recursos</a>
        <a href="/informe-demostrativo">Informe demostrativo</a>
        <a href="/recursos/checklist-seguridad-pyme">Checklist para pymes</a>
        <a href="/seguridad-autorizacion-alcance">Autorización y alcance</a>
        <a href="/preguntas-frecuentes">Preguntas frecuentes</a>
        <a href="/valoracion">Solicitar valoración</a>
      </nav>
    </div>
  </div>
</footer>
  <a class="whatsapp" href="#" data-wa-modal data-wa-message="Hola Jaime, quiero solicitar una valoración inicial de ciberseguridad." aria-label="Contactar por WhatsApp"><span>WA</span><b>Solicitar valoración</b></a>
  <AsistenteIA />
  <WhatsAppModal />
  <script>
    const b=document.querySelector('.menu-button'); const m=document.querySelector('.menu');
    b?.addEventListener('click',()=>{const o=m?.classList.toggle('menu-open');b.setAttribute('aria-expanded',String(Boolean(o)));});
    m?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{m.classList.remove('menu-open');b?.setAttribute('aria-expanded','false');}));
    const nodes=document.querySelectorAll('[data-reveal]');
    if('IntersectionObserver' in window){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}}),{threshold:.09});nodes.forEach(n=>io.observe(n));}else{nodes.forEach(n=>n.classList.add('visible'));}
  </script>
<!-- JEFQ-AUTORIDAD-REAL-V1 -->
<script defer src="/_vercel/insights/script.js"></script>
<script defer src="/jefq-events.js"></script>
<Analytics />
</body>
</html>