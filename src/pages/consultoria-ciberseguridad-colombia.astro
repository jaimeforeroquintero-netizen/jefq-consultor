---
import ServiceLanding from "../components/ServiceLanding.astro";
import { servicePages } from "../data/service-pages";
const service = servicePages.find((item) => item.slug === "consultoria-ciberseguridad-colombia");
if (!service) throw new Error("No se encontro el servicio consultoria-ciberseguridad-colombia");
---
<ServiceLanding service={service} />