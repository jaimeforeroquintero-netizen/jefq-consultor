---
import Layout from "../layouts/Layout.astro";

const practicas = [
  { titulo: "Entorno separado", texto: "Las pruebas y validaciones de desarrollo se plantean en entornos controlados, evitando usar activos de clientes sin alcance y autorización." },
  { titulo: "Datos sintéticos", texto: "Los compradores, escenarios y métricas empleados para explorar hipótesis comerciales se rotulan como simulaciones y no como demanda real." },
  { titulo: "Reproducibilidad", texto: "Los laboratorios comerciales usan semillas fijas, archivos CSV y reportes para poder repetir escenarios y comparar cambios." },
  { titulo: "Revisión previa", texto: "Cada cambio técnico se acompaña de build previo, backup, build final y verificación de rutas antes del despliegue." },
  { titulo: "Evidencia mínima", texto: "Los reportes conservan fecha, alcance, limitaciones, archivos generados y hashes cuando corresponde." },
  { titulo: "Límites explícitos", texto: "El laboratorio no sustituye usuarios reales, pruebas legales, validación profesional ni una auditoría externa." }
];
---
<Layout title="Laboratorio JEFQ | Método, pruebas y límites" description="Laboratorio público de JEFQ Consultor: entornos controlados, datos sintéticos, reproducibilidad y límites profesionales.">
  <main class="evidence-page">
    <section class="evidence-hero compact">
      <div class="container">
        <span class="evidence-stamp">LABORATORIO PÚBLICO · SIN DATOS DE CLIENTES</span>
        <p class="section-label">MÉTODO Y REPRODUCIBILIDAD</p>
        <h1>Cómo probamos ideas sin confundir simulación con evidencia real</h1>
        <p class="evidence-lead">El laboratorio JEFQ reúne pruebas de desarrollo, validaciones controladas y modelos sintéticos para identificar hipótesis. Sus resultados orientan decisiones, pero no se presentan como clientes, tráfico o ventas.</p>
      </div>
    </section>
    <section class="section"><div class="container evidence-grid evidence-grid-3">{practicas.map((item,index) => (<article><span>{String(index + 1).padStart(2,"0")}</span><h2>{item.titulo}</h2><p>{item.texto}</p></article>))}</div></section>
    <section class="section dark-section"><div class="container"><header class="section-header"><span>FLUJO</span><h2>De una hipótesis a una decisión controlada</h2></header><div class="evidence-timeline"><article><strong>01</strong><h3>Hipótesis</h3><p>Se define una pregunta concreta.</p></article><article><strong>02</strong><h3>Simulación</h3><p>Se construye un escenario reproducible.</p></article><article><strong>03</strong><h3>Contraste</h3><p>Se revisan objeciones, límites y coherencia.</p></article><article><strong>04</strong><h3>Decisión</h3><p>Solo se aplican cambios de bajo riesgo y utilidad clara.</p></article><article><strong>05</strong><h3>Validación posterior</h3><p>Se contrasta con analítica, feedback o resultados reales cuando existan.</p></article></div></div></section>
    <section class="section"><div class="container evidence-callout"><div><p class="section-label">RECURSOS RELACIONADOS</p><h2>Revise la evidencia y su evolución</h2><p>Consulte la autoevaluación pública, el informe demostrativo y el historial de cambios documentados.</p></div><div class="evidence-actions"><a class="button primary" href="/autoevaluacion-jefq">Autoevaluación</a><a class="button secondary" href="/mejoras-del-proyecto">Historial de mejoras</a><a class="button secondary" href="/herramientas-probadas">Herramientas probadas</a></div></div></section>
  </main>
</Layout>