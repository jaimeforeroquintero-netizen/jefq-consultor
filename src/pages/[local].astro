---
import Layout from "../layouts/Layout.astro";
import { localPages } from "../data/growth-content";
export function getStaticPaths(){return localPages.map(page=>({params:{local:page.slug},props:{page}}));}
const { page } = Astro.props;
---
<Layout title={page.title} description={page.description}>
<section class="local-hero"><div class="container local-layout"><div><span>JEFQ CONSULTOR</span><h1>{page.heading}</h1><p>{page.intro}</p><a href="/valoracion" target="_blank" rel="noopener">Solicitar valoración</a></div><aside><h2>Enfoque del servicio</h2><ul>{page.points.map(point=><li>✓ {point}</li>)}</ul></aside></div></section>
<section class="local-body"><div class="container"><h2>Seguridad proporcional y documentada</h2><p>Antes de cualquier actividad se definen objetivos, activos, restricciones y autorización. Los resultados se organizan para facilitar decisiones y remediación.</p><div class="local-grid"><article><h3>Diagnóstico</h3><p>Identificación inicial de riesgos y prioridades.</p></article><article><h3>Fortalecimiento</h3><p>Hardening y acompañamiento según el alcance.</p></article><article><h3>Informes</h3><p>Evidencia técnica y resumen ejecutivo.</p></article></div></div></section>
<section class="local-body"><div class="container"><h2>Cobertura en Colombia</h2><p>Atención remota en <a href="/cobertura/bogota">Bogotá</a>, <a href="/cobertura/medellin">Medellín</a>, <a href="/cobertura/cali">Cali</a>, <a href="/cobertura/barranquilla">Barranquilla</a>, <a href="/cobertura/cartagena">Cartagena</a>, <a href="/cobertura/bucaramanga">Bucaramanga</a>, <a href="/cobertura/pereira">Pereira</a> y <a href="/cobertura/manizales">Manizales</a>, y en todo el país. También: <a href="/ciberseguridad-bogota">ciberseguridad para empresas en Bogotá</a> y <a href="/consultor-ciberseguridad-bogota">consultor de ciberseguridad en Bogotá</a>.</p></div></section>
</Layout>
<style>
.local-hero{padding:7rem 0;background:radial-gradient(circle at 80% 25%,rgba(37,215,255,.12),transparent 30rem)}.local-layout{display:grid;grid-template-columns:1.2fr .8fr;gap:4rem;align-items:center}.local-hero span{color:#25d7ff;font-size:.76rem;font-weight:850;letter-spacing:.14em}.local-hero h1{font-size:clamp(2.8rem,7vw,5.6rem);line-height:1;letter-spacing:-.055em}.local-hero p,.local-body p{color:#aebfd1}.local-hero a{display:inline-flex;margin-top:1rem;padding:.85rem 1.1rem;color:#001018;background:linear-gradient(135deg,#25d7ff,#67f2ae);border-radius:10px;font-weight:850}.local-hero aside,.local-grid article{padding:1.6rem;background:#0a1b30;border:1px solid rgba(117,170,216,.18);border-radius:20px}.local-hero li{margin:.7rem 0;color:#cbd8e4}.local-body{padding:5rem 0 7rem}.local-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:2rem}@media(max-width:760px){.local-layout,.local-grid{grid-template-columns:1fr}}
</style>