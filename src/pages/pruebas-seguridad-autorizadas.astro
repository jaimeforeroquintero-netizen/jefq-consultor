---
import ServiceLanding from "../components/ServiceLanding.astro";
import { servicePages } from "../data/service-pages";
const service = servicePages.find((item) => item.slug === "pruebas-seguridad-autorizadas");
if (!service) throw new Error("No se encontro el servicio pruebas-seguridad-autorizadas");
---
<ServiceLanding service={service} />