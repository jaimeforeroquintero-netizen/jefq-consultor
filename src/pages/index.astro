<script>
const f=document.querySelector('#contact-form');f?.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(f);const text=["Hola Jaime, quiero información sobre ciberseguridad.","",`Nombre: ${d.get('nombre')}`,`Empresa: ${d.get('empresa')||'No indicada'}`,`Servicio: ${d.get('servicio')}`,`Activos: ${d.get('activos')}`,`Necesidad: ${d.get('mensaje')}`].join('\n');if(window.JEFQ_wa){window.JEFQ_wa.open(text);}});
// Barra CTA al hacer scroll: aparece tras el hero, se oculta en contacto/footer
(function(){var bar=document.getElementById('scroll-cta');if(!bar)return;var hero=document.querySelector('.hero');var contact=document.getElementById('contacto');var foot=document.querySelector('.footer');var past=false,nearEnd=false;
function upd(){bar.classList.toggle('show',past&&!nearEnd);bar.setAttribute('aria-hidden',past&&!nearEnd?'false':'true');}
function onScroll(){var y=window.scrollY||0;past=y>(hero?hero.offsetHeight*0.75:600);upd();}
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.target===contact||e.target===foot){nearEnd=e.isIntersecting;upd();}});},{threshold:0.08});
if(contact)io.observe(contact);if(foot)io.observe(foot);
window.addEventListener('scroll',onScroll,{passive:true});onScroll();})();
// Mini-calculadora de costo de inactividad
(function(){var inp=document.getElementById('calc-monthly'),btn=document.getElementById('calc-btn'),res=document.getElementById('calc-result');if(!inp||!btn||!res)return;var DIAG=390000;
function fmt(n){return '$'+Math.round(n).toLocaleString('es-CO');}
function calc(){var m=parseFloat(String(inp.value).replace(/[^\d.]/g,''))||0;if(m<=0){res.hidden=true;return;}var day=m/30;document.getElementById('calc-day').textContent=fmt(day);document.getElementById('calc-loss-val').textContent=fmt(day);
var mx=Math.max(day,DIAG);document.getElementById('calc-fill-loss').style.width=Math.max(4,(day/mx*100))+'%';document.getElementById('calc-fill-diag').style.width=Math.max(4,(DIAG/mx*100))+'%';res.hidden=false;}
btn.addEventListener('click',calc);inp.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();calc();}});})();
</script>
