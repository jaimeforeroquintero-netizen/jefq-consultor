];
const plans = PRECIOS.filter((p) => p.producto).map((p) => ({ name: p.nombre, price: `Desde ${formatearCOP(precioDe(p.id))}`, producto: p.producto, precioNum: precioDe(p.id), text: p.texto ?? "", featured: p.destacado ?? false, items: p.incluye }));

import EvidenceRealStrip from "../components/EvidenceRealStrip.astro";
import ProcessDiagram from "../components/ProcessDiagram.astro";
import PlanesComparativaProgresiva from "../components/PlanesComparativaProgresiva.astro";
import ScanTerminal from "../components/ScanTerminal.astro";
import VideoPromo from "../components/VideoPromo.astro";
