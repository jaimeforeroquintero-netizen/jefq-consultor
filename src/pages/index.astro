 {n:"04",t:"Informes técnicos y ejecutivos",d:"Traducimos hallazgos en evidencia, impacto, prioridad y acciones concretas de remediación.",url:"/servicios/informes-tecnicos"},
 {n:"05",t:"Simulacros de seguridad",d:"Ejercicios responsables para evaluar personas y procesos sin exceder el alcance autorizado.",url:"/servicios/simulacros-seguridad"},
