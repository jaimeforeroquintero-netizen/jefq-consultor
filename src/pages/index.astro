---
import Layout from "../layouts/Layout.astro";
const wa="https://wa.me/573174832132?text="+encodeURIComponent("Hola Jaime, quiero solicitar una valoración inicial de ciberseguridad.");
const services=[
 {n:"01",icon:"◇",t:"Diagnóstico de seguridad",d:"Identificamos exposición, configuraciones débiles y riesgos prioritarios para orientar un plan de mejora realista.",url:"/servicios/diagnostico-seguridad"},
 {n:"02",icon:"⌁",t:"Pruebas autorizadas",d:"Evaluaciones controladas bajo autorización escrita, alcance definido y medidas para proteger la continuidad operativa.",url:"/servicios/pruebas-autorizadas"},
 {n:"03",icon:"▣",t:"Hardening de sistemas",d:"Fortalecemos equipos Windows, cuentas, navegadores, aplicaciones y configuraciones empresariales.",url:"/servicios/hardening"},
 {n:"04",icon:"≣",t:"Informes profesionales",d:"Traducimos hallazgos en evidencia, impacto, prioridad y acciones concretas de remediación.",url:"/servicios/informes-tecnicos"},
 {n:"05",icon:"◎",t:"Simulacros de seguridad",d:"Ejercicios responsables para evaluar personas y procesos sin exceder el alcance autorizado.",url:"/servicios/simulacros-seguridad"},
 {n:"06",icon:"↗",t:"Acompañamiento",d:"Apoyamos la priorización, aplicación y comprobación de correcciones para cerrar brechas.",url:"/servicios/acompanamiento-remediacion"}
];
const plans=[
 {name:"Diagnóstico Esencial",price:"Desde $390.000",text:"Punto de partida para profesionales y microempresas.",items:["Reunión remota","Hasta 3 equipos","Riesgos prioritarios","Informe ejecutivo","Sesión de resultados"]},
 {name:"Evaluación Pyme",price:"Desde $890.000",text:"Evaluación ampliada con ruta de mejora.",featured:true,items:["Alcance autorizado","Hasta 10 activos","Revisión de configuraciones","Informe técnico y ejecutivo","Plan de remediación","Acompañamiento"]},
 {name:"Seguridad Integral",price:"Desde $1.790.000",text:"Fortalecimiento por capas y seguimiento.",items:["Alcance personalizado","Evaluación autorizada","Hardening priorizado","Evidencias","Plan por etapas","Dos seguimientos"]}
];

import TrustPremium from "../components/TrustPremium.astro";
import PymeRisks from "../components/PymeRisks.astro";
import ConversionEvidence from "../components/ConversionEvidence.astro";
import EvidenceRealStrip from "../components/EvidenceRealStrip.astro";
---
<Layout title="JEFQ Consultor | Ciberseguridad para empresas en Colombia" description="Consultoría, hardening, pruebas autorizadas e informes de ciberseguridad para empresas en Bogotá y toda Colombia.">
<section class="hero"><div class="grid-bg"></div><div class="orb orb-a"></div><div class="orb orb-b"></div><div class="container hero-grid">
  <div class="hero-copy" data-reveal><div class="eyebrow"><i></i>Ciberseguridad práctica para Colombia</div><h1>Proteja su pyme antes de que un incidente interrumpa la operación.</h1><p>JEFQ Consultor convierte riesgos técnicos en decisiones claras para proteger equipos, cuentas, información y procesos empresariales.</p><div class="hero-actions"><a class="button primary" href={wa} target="_blank" rel="noopener">Solicitar valoración</a><a class="button ghost" href="#servicios">Explorar servicios</a></div><div class="hero-trust"><span>Autorización previa</span><span>Alcance controlado</span><span>Informes accionables</span></div></div>
  <div class="visual" data-reveal><div class="visual-head"><span>PROCESO DE EVALUACIÓN</span><b>METODOLOGÍA</b></div><div class="radar"><div class="ring r1"></div><div class="ring r2"></div><div class="ring r3"></div><div class="cross x"></div><div class="cross y"></div><div class="sweep"></div><div class="core">J</div><i class="dot d1"></i><i class="dot d2"></i><i class="dot d3"></i></div><div class="visual-steps"><div><b>01</b><span>Diagnosticar</span></div><div><b>02</b><span>Priorizar</span></div><div><b>03</b><span>Fortalecer</span></div></div></div>
</div></section>
<section class="proof"><div class="container proof-grid"><article><b>Autorizado</b><span>Pruebas con alcance escrito</span><a class="service-discover-link" href="/servicios/hardening" aria-label="Descubrir el hardening">
  <span>Descubrir el hardening</span>
  <span aria-hidden="true">→</span>
</a><a class="service-discover-link" href="/servicios/pruebas-autorizadas" aria-label="Descubrir las pruebas autorizadas">
  <span>Descubrir las pruebas autorizadas</span>
  <span aria-hidden="true">→</span>
</a><a class="service-discover-link" href="/servicios/acompanamiento-remediacion" aria-label="Descubrir el acompañamiento">
  <span>Descubrir el acompañamiento</span>
  <span aria-hidden="true">→</span>
</a></article><article><b>Comprensible</b><span>Informe técnico y ejecutivo</span></article><article><b>Nacional</b><span>Atención remota en Colombia</span></article><article><b>Accionable</b><span>Prioridades y ruta de mejora</span></article></div></section>
<TrustPremium />
<PymeRisks />

<section class="section" id="servicios"><div class="container"><header class="section-head" data-reveal><span>SERVICIOS</span><h2>Seguridad adaptada a su realidad</h2><p>Una propuesta proporcional al tamaño, exposición y necesidades de cada organización.</p></header><div class="service-grid">{services.map(s=><article class="service-card" data-reveal><div class="service-top"><span class="service-icon">{s.icon}</span><small>{s.n}</small></div><h3>{s.t}</h3><p>{s.d}</p><a class="service-card-link" href={s.url} aria-label={`Conocer ${s.t}`}>Descubrir el servicio <b>→</b></a></article>)}</div></div></section>
<section class="section contrast" id="metodologia"><div class="container method-grid"><header class="section-head left" data-reveal><span>METODOLOGÍA</span><h2>Control, claridad y evidencia</h2><p>Cada intervención protege el alcance, documenta lo realizado y prioriza lo importante.</p><div class="promise"><b>Compromiso operativo</b><p>No realizamos pruebas sobre activos sin autorización verificable.</p></div></header><div class="process">{[["01","Conocer el contexto","Objetivos, activos, restricciones y riesgos."],["02","Definir el alcance","Autorización, límites y condiciones de ejecución."],["03","Evaluar con control","Pruebas proporcionales y evidencia organizada."],["04","Entregar y acompañar","Prioridades, remediación y seguimiento."]].map(x=><article data-reveal><b>{x[0]}</b><div><h3>{x[1]}</h3><p>{x[2]}</p></div></article>)}</div></div></section>
<section class="section why"><div class="container why-grid"><div class="why-visual" data-reveal><div class="shield">J<span></span></div><div class="orbit o1"></div><div class="orbit o2"></div></div><div data-reveal><span class="label">POR QUÉ JEFQ</span><h2>Seguridad entendible y orientada a decisiones</h2><div class="benefits"><article><b>Lenguaje claro</b><p>Explicaciones útiles para responsables técnicos y administrativos.</p></article><article><b>Priorización real</b><p>Primero lo que representa mayor exposición o impacto.</p></article><article><b>Atención directa</b><p>Contacto con Jaime Forero durante el proceso.</p></article><article><b>Diseño proporcional</b><p>Sin implantar complejidad o productos que no aporten valor.</p></article></div></div></div></section>
<section class="section contrast" id="planes"><div class="container"><header class="section-head" data-reveal><span>INVERSIÓN ORIENTATIVA</span><h2>Planes de entrada transparentes</h2><p>El valor final depende del alcance, los activos y la complejidad.</p></header><div class="pricing-grid">{plans.map(p=><article class:list={["price-card",{featured:p.featured}]} data-reveal>{p.featured&&<span class="badge">RECOMENDADO PARA PYMES</span>}<h3>{p.name}</h3><strong class="price">{p.price}</strong><p>{p.text}</p><ul>{p.items.map(i=><li><i>✓</i>{i}</li>)}</ul><a class="button price-button" href={wa} target="_blank" rel="noopener">Solicitar valoración</a></article>)}</div><p class="price-note">Consultoría remota desde $120.000 COP por hora. Hardening Windows desde $290.000 COP. Valores sujetos al alcance acordado.</p></div></section>
<section class="section" id="casos"><div class="container"><header class="section-head" data-reveal><span>EJEMPLOS DE INTERVENCIÓN</span><h2>Así se estructura una intervención</h2><p>Empresas y situaciones ficticias para explicar el servicio, no testimonios reales.</p></header><div class="cases"><article class="case" data-reveal><div class="case-head"><span>ESCENARIO 01 · ILUSTRATIVO</span><b>Hardening</b></div><h3>Comercializadora de 12 personas</h3><div class="case-flow"><div><small>SITUACIÓN</small><p>Equipos con configuraciones heterogéneas y controles insuficientes.</p></div><div><small>INTERVENCIÓN</small><p>Diagnóstico, hardening de estaciones Windows y plan de actualización.</p></div><div><small>ENTREGABLE</small><p>Ruta priorizada con evidencias y acciones de mejora.</p></div></div><em>Nombre y situación completamente ficticios.</em></article><article class="case" data-reveal><div class="case-head"><span>ESCENARIO 02 · ILUSTRATIVO</span><b>Evaluación</b></div><h3>Firma profesional con trabajo remoto</h3><div class="case-flow"><div><small>SITUACIÓN</small><p>Necesidad de revisar exposición antes de ampliar la operación digital.</p></div><div><small>INTERVENCIÓN</small><p>Evaluación controlada y clasificación de hallazgos.</p></div><div><small>ENTREGABLE</small><p>Informe ejecutivo, evidencia técnica y plan de remediación.</p></div></div><em>Nombre y situación completamente ficticios.</em></article></div></div></section>
<ConversionEvidence />

<section class="section contact" id="contacto"><div class="container contact-grid"><div data-reveal><span class="label">CONTACTO</span><h2>Conversemos sobre lo que necesita proteger</h2><p>La valoración inicial permite definir alcance, tiempos y una cotización proporcional.</p><div class="contact-data"><a href="tel:+573174832132"><small>Teléfono y WhatsApp</small><b>317 483 2132</b></a><div><small>Cobertura</small><b>Bogotá y toda Colombia</b></div><div><small>Atención</small><b>Lunes a sábado, horario de oficina</b></div></div></div>
<form class="contact-form" id="contact-form" data-reveal><div class="form-row"><label>Nombre<input name="nombre" required maxlength="80" autocomplete="name" /></label><label>Empresa<input name="empresa" maxlength="100" autocomplete="organization" /></label></div><div class="form-row"><label>Servicio<select name="servicio" required><option value="">Seleccione</option><option>Diagnóstico</option><option>Pruebas autorizadas</option><option>Hardening</option><option>Informe</option><option>Simulacro</option><option>Consultoría</option></select></label><label>Número de activos<select name="activos" required><option value="">Seleccione</option><option>1 a 5</option><option>6 a 20</option><option>Más de 20</option><option>Por definir</option></select></label></div><label>Necesidad<textarea name="mensaje" rows="5" required maxlength="700" placeholder="Describa brevemente qué desea proteger o evaluar"></textarea>
<p class="sensitive-warning">No incluya contraseñas, códigos MFA, llaves privadas, vulnerabilidades explotables ni datos personales sensibles.</p>
<p class="sensitive-data-warning">No incluya contraseñas, códigos MFA, llaves privadas, vulnerabilidades explotables ni datos personales sensibles.</p></label><label class="consent"><input type="checkbox" required /><span>Acepto la <a href="/privacidad">política de privacidad</a>.</span></label><p class="data-safety-note"><strong>Proteja su información:</strong> no envíe contraseñas, códigos MFA, llaves, archivos confidenciales ni detalles explotables. El primer contacto solo debe describir la necesidad de forma general.</p>
        <button class="button primary full" type="submit">Contactar por WhatsApp</button><small>No almacenamos este formulario. El mensaje se prepara para que pueda revisarlo.</small></form></div></section>
<script>
const f=document.querySelector('#contact-form');f?.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(f);const text=["Hola Jaime, quiero información sobre ciberseguridad.","",`Nombre: ${d.get('nombre')}`,`Empresa: ${d.get('empresa')||'No indicada'}`,`Servicio: ${d.get('servicio')}`,`Activos: ${d.get('activos')}`,`Necesidad: ${d.get('mensaje')}`].join('\n');window.open(`https://wa.me/573174832132?text=${encodeURIComponent(text)}`,'_blank','noopener,noreferrer');});
</script>
  <EvidenceRealStrip />
</Layout>
