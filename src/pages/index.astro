---
import Layout from "../layouts/Layout.astro";
import { PRECIOS, precioDe, formatearCOP } from "../data/precios";
const services=[
 {n:"01",t:"Diagnóstico de seguridad",d:"Identificamos exposición, configuraciones débiles y riesgos prioritarios para orientar un plan de mejora realista.",url:"/servicios/diagnostico-seguridad"},
 {n:"02",t:"Hardening de sistemas",d:"Fortalecemos equipos Windows, cuentas, navegadores, aplicaciones y configuraciones empresariales.",url:"/servicios/hardening"},
 {n:"03",t:"Pruebas autorizadas",d:"Evaluaciones controladas bajo autorización escrita, alcance definido y medidas para proteger la continuidad operativa.",url:"/servicios/pruebas-autorizadas"},
 {n:"04",t:"Informes técnicos y ejecutivos",d:"Traducimos hallazgos en evidencia, impacto, prioridad y acciones concretas de remediación.",url:"/servicios/informes-tecnicos"},
 {n:"05",t:"Simulacros de seguridad",d:"Ejercicios responsables para evaluar personas y procesos sin exceder el alcance autorizado.",url:"/servicios/simulacros-seguridad"},
 {n:"06",t:"Acompañamiento de remediación",d:"Apoyamos la priorización, aplicación y comprobación de correcciones para cerrar brechas.",url:"/servicios/acompanamiento-remediacion"},
 {n:"07",t:"Seguridad para IA",d:"Evaluamos el uso de herramientas de inteligencia artificial en su empresa: datos en prompts, apps sin gobierno y riesgos de suplantación.",url:"/seguridad-inteligencia-artificial"}
];
const plans = PRECIOS.filter((p) => p.producto).map((p) => ({ name: p.nombre, price: `Desde ${formatearCOP(precioDe(p.id))}`, producto: p.producto, precioNum: precioDe(p.id), text: p.texto ?? "", featured: p.destacado ?? false, items: p.incluye }));

import ProcessDiagram from "../components/ProcessDiagram.astro";
import PlanesComparativaProgresiva from "../components/PlanesComparativaProgresiva.astro";
import ScanTerminal from "../components/ScanTerminal.astro";
import VideoPromo from "../components/VideoPromo.astro";
---
<Layout title="JEFQ Consultor | Ciberseguridad para empresas en Colombia" description="Diagnóstico, hardening, pruebas autorizadas e informes de ciberseguridad para PYMES y empresas en Bogotá y toda Colombia.">
<section class="hero"><canvas class="hero-canvas" id="hero-particles" aria-hidden="true"></canvas><div class="container hero-grid">
  <div class="hero-copy" data-reveal><div class="eyebrow"><i></i>Ciberseguridad práctica para Colombia</div><h1>Diagnóstico de ciberseguridad <span>para PYMES en Colombia</span></h1><p>Sepa exactamente dónde está expuesto antes de que un incidente lo descubra por usted. <a class="inline-link" href="/servicios/diagnostico-seguridad">Evaluación autorizada</a>, informe ejecutivo que su gerencia sí entiende y ruta de remediación priorizada — desde {formatearCOP(precioDe("esencial"))}, con atención directa del consultor.</p><div class="hero-actions"><a class="button primary" href="/valoracion">Solicitar valoración</a><a class="button secondary" href="#servicios">Explorar servicios</a><a class="button secondary" href="/api/whatsapp?text=Hola%20Jaime%2C%20quiero%20informaci%C3%B3n%20sobre%20los%20servicios%20de%20JEFQ%20Consultor.">Prefiero escribir por WhatsApp</a></div><div class="hero-trust"><span>Autorización previa</span><span>Alcance controlado</span><span>Informes accionables</span></div></div>
  <div class="visual" data-reveal><div class="visual-steps"><div><b>01</b><span>Diagnosticar</span></div><div><b>02</b><span>Priorizar</span></div><div><b>03</b><span>Fortalecer</span></div></div><ScanTerminal /></div>
</div></section>
<VideoPromo />
<section class="proof"><div class="container proof-grid"><a href="/como-trabajamos"><b>Autorizado</b><span>Pruebas con alcance escrito</span></a><a href="/informe-demostrativo"><b>Comprensible</b><span>Informe técnico y ejecutivo</span></a><a href="/ciberseguridad-bogota"><b>Nacional</b><span>Atención remota en Colombia</span></a><a href="/valoracion"><b>Accionable</b><span>Prioridades y ruta de mejora</span></a></div></section>
<section class="section" id="amenaza-2026"><div class="container"><header class="section-head" data-reveal><span>LA AMENAZA DE 2026</span><h2>Ya no tocan la puerta: entran con sus claves</h2><p>El robo de credenciales desplazó al phishing como la puerta de entrada más común a las empresas. Los reportes de 2026 lo confirman, y Colombia está en la mira: en octubre de 2026 el grupo Qilin atacó una empresa del sector energético en el país.</p><div class="section-cta" data-reveal><a href="/servicios">Ver cómo nos defendemos</a></div></header></div></section>

<section class="section" id="servicios"><div class="container"><header class="section-head" data-reveal><span>SERVICIOS</span><h2>Seguridad adaptada a su realidad</h2><p>Una propuesta proporcional al tamaño, exposición y necesidades de cada organización.</p></header><div class="carrusel"><div class="carrusel-pista" id="pista-servicios">{services.map(s=><article class="service-card" data-reveal><div class="service-top"><small>{s.n}</small></div><h3>{s.t}</h3><p>{s.d}</p><a class="service-card-link" href={s.url} aria-label={`Conocer ${s.t}`}>Descubrir el servicio <b>→</b></a></article>)}</div><div class="carrusel-nav"><button class="carrusel-btn" id="carrusel-antes" aria-label="Servicios anteriores">‹</button><div class="carrusel-progreso"><i id="carrusel-barra"></i></div><button class="carrusel-btn" id="carrusel-despues" aria-label="Servicios siguientes">›</button></div></div><div class="section-cta" data-reveal><span>¿No sabe por dónde empezar?</span><a class="button secondary" href="/valoracion">Hacer la valoración en línea</a></div></div></section>
<section class="section contrast" id="metodologia"><div class="container method-grid"><header class="section-head left" data-reveal><span>METODOLOGÍA</span><h2>Control, claridad y evidencia</h2><p>Cada intervención protege el alcance, documenta lo realizado y prioriza lo importante.</p><div class="promise"><b>Compromiso operativo</b><p>No realizamos pruebas sobre activos sin autorización verificable.</p></div></header><ProcessDiagram /></div></section>
<section class="section why"><div class="container why-grid"><div class="why-visual" data-reveal><div class="shield"><img src="/logo-jefq-simbolo.svg" alt="" width="170" height="170" /></div><div class="orbit o1"></div><div class="orbit o2"></div></div><div data-reveal><span class="label">POR QUÉ JEFQ</span><h2>Seguridad entendible y orientada a decisiones</h2><div class="benefits"><a href="/informe-demostrativo"><b>Lenguaje claro</b><p>Explicaciones útiles para responsables técnicos y administrativos.</p></a><a href="/servicios/diagnostico-seguridad/#muestra-informe"><b>Priorización real</b><p>Primero lo que representa mayor exposición o impacto.</p></a><article><b>Atención directa</b><p>Contacto con <a class="inline-link" href="/quien-soy">Jaime Forero</a> durante el proceso.</p></article><a href="/valoracion"><b>Diseño proporcional</b><p>Sin implantar complejidad o productos que no aporten valor.</p></a></div><p class="why-diff" data-reveal>Ni el sobrino que "sabe de computadores", ni la multinacional que cobra en dólares: <b>un consultor dedicado que habla el idioma de su negocio</b>. Respondemos por cada hallazgo documentado en su informe: le explicamos qué significa, qué riesgo implica y qué le recomendamos hacer.</p><div class="section-cta" data-reveal><span>¿Y si no entiendo de tecnología? El informe ejecutivo está escrito para gerencia, no para ingenieros.</span><a class="button secondary" href="/valoracion">Hacer la valoración en línea</a></div></div></div></section>
<section class="section contrast" id="planes"><div class="container"><header class="section-head" data-reveal><span>INVERSIÓN ORIENTATIVA</span><h2>Planes de entrada transparentes</h2><p>El valor final depende del alcance, los activos y la complejidad.</p></header><div class="pricing-grid">{plans.map(p=><article class:list={["price-card",{featured:p.featured}]} data-reveal>{p.featured&&<span class="badge">RECOMENDADO PARA PYMES</span>}<h3>{p.name}</h3><strong class="price font-datos">{p.price}</strong><p>{p.text}</p><ul>{p.items.map(i=><li><i>✓</i>{i}</li>)}</ul><a class="button price-button" href="/valoracion">Solicitar valoración</a></article>)}</div><PlanesComparativaProgresiva /><p class="price-anchor" data-reveal>Un solo incidente de seguridad puede detener su operación por días. La prevención profesional empieza en <b class="font-datos">{formatearCOP(precioDe("esencial"))}</b>.</p><p class="price-note">Consultoría remota desde <span class="font-datos">{formatearCOP(precioDe("consultoria-hora"))}</span> COP por hora. Hardening de sistemas desde <span class="font-datos">{formatearCOP(precioDe("hardening"))}</span> COP. Valores sujetos al alcance acordado.</p><p class="sample-link" data-reveal><a href="/servicios/diagnostico-seguridad/#muestra-informe">Ver cómo se ve el informe →</a></p>
<div class="downtime-calc" data-reveal>
  <h3>¿Cuánto pierde su empresa por un día sin operar?</h3>
  <p>Escriba su facturación mensual aproximada y compare:</p>
  <div class="calc-row">
    <label>Facturación mensual (COP)<input type="number" id="calc-monthly" min="0" step="100000" placeholder="Ej: 30.000.000" inputmode="numeric" /></label>
    <button type="button" class="button primary" id="calc-btn">Calcular</button>
  </div>
  <div class="calc-result" id="calc-result" hidden>
    <p class="calc-loss">Un día detenido le cuesta aprox. <b id="calc-day">—</b></p>
    <div class="calc-bars">
      <div class="calc-bar-row"><span>1 día sin operar</span><div class="calc-track"><div class="calc-fill loss" id="calc-fill-loss"></div></div><b id="calc-loss-val"></b></div>
      <div class="calc-bar-row"><span>Diagnóstico Esencial</span><div class="calc-track"><div class="calc-fill diag" id="calc-fill-diag"></div></div><b>{formatearCOP(precioDe("esencial"))}</b></div>
    </div>
    <small>Estimación ilustrativa: su facturación mensual dividida entre 30 días. No incluye costos adicionales como multas, reputación o recuperación.</small>
  </div>
</div>
<div class="section-cta" data-reveal><span>¿No sabe cuál plan se ajusta a su empresa?</span><a class="button secondary" href="/valoracion">Hacer la valoración en línea</a></div></div></section>
<section class="section" id="garantia"><div class="container"><div class="guarantee" data-reveal><span class="guarantee-badge">GARANTÍA HONESTA</span><p>"Si el diagnóstico no encuentra nada relevante, se lo decimos de frente y no le vendemos lo que no necesita."</p><small>— Jaime Forero, JEFQ Consultor</small></div></div></section>

<section class="section" id="evidencia"><div class="container"><header class="section-head" data-reveal><span>EVIDENCIA</span><h2>Así trabajamos: escenarios ilustrativos de intervención</h2><p>Escenarios representativos con fines ilustrativos.</p></header><h3 class="evidencia-sub" data-reveal>Escenarios ilustrativos: cómo se estructura una intervención</h3><div class="cases"><a class="case" data-reveal href="/servicios/hardening"><div class="case-head"><span>ESCENARIO 01 · Ejemplo ilustrativo</span><b>Hardening de sistemas</b></div><h3>Comercializadora de 12 personas</h3><div class="case-flow"><div><small>SITUACIÓN</small><p>Equipos con configuraciones heterogéneas y controles insuficientes.</p></div><div><small>INTERVENCIÓN</small><p>Diagnóstico, hardening de estaciones Windows y plan de actualización.</p></div><div><small>ENTREGABLE</small><p>Ruta priorizada con evidencias y acciones de mejora.</p></div></div><em>Nombre y situación completamente ficticios.</em></a><a class="case" data-reveal href="/servicios/diagnostico-seguridad"><div class="case-head"><span>ESCENARIO 02 · Ejemplo ilustrativo</span><b>Evaluación</b></div><h3>Firma profesional con trabajo remoto</h3><div class="case-flow"><div><small>SITUACIÓN</small><p>Necesidad de revisar exposición antes de ampliar la operación digital.</p></div><div><small>INTERVENCIÓN</small><p>Evaluación controlada y clasificación de hallazgos.</p></div><div><small>ENTREGABLE</small><p>Informe ejecutivo, evidencia técnica y plan de remediación.</p></div></div><em>Nombre y situación completamente ficticios.</em></a></div></div></section>
{/* Cierre-final (Misión 80): la tira de evidencia sobre el propio proyecto va junto a #evidencia, su casa temática; #contacto queda como última sección de contenido antes del pie. Sin cambio de contenido ni de precios. */}

<section class="section" id="confianza"><div class="container"><header class="section-head" data-reveal><span>POR QUÉ CONFIAR</span><h2>Por qué confiar en JEFQ</h2><p>Todavía no tenemos testimonios de clientes. Esto es lo que sí podemos mostrarle para que decida con confianza.</p></header>
<div class="trust-grid">
<article class="trust-card" data-reveal><span class="trust-num font-datos">01</span><h3>Precios de entrada publicados.</h3><p>Diagnóstico Esencial desde {formatearCOP(precioDe("esencial"))}, Evaluación PYME desde {formatearCOP(precioDe("pyme"))} y Seguridad Integral desde {formatearCOP(precioDe("integral"))}.</p><div class="trust-links"><a class="trust-link" href="/#planes">Ver planes →</a></div></article>
<article class="trust-card" data-reveal><span class="trust-num font-datos">02</span><h3>Primero la valoración gratuita.</h3><p>Valoración gratuita en 4 pasos, sin compromiso, antes de cobrar nada.</p><div class="trust-links"><a class="trust-link" href="/valoracion/">Ver la valoración →</a></div></article>
<article class="trust-card" data-reveal><span class="trust-num font-datos">03</span><h3>Un método que se ve.</h3><p>Cuatro pasos claros —contexto, alcance, evaluación con control, entrega y acompañamiento— y un compromiso publicado: ninguna prueba sobre activos sin autorización verificable.</p><div class="trust-links"><a class="trust-link" href="/#metodologia">Ver el método →</a></div></article>
<article class="trust-card" data-reveal><span class="trust-num font-datos">04</span><h3>Nada se toca sin su autorización.</h3><p>Ninguna evaluación comienza sin una definición clara del alcance, los permisos y las condiciones. Durante el servicio, todo se mantiene dentro de lo acordado; cualquier ampliación requiere su aprobación previa. La información que nos comparte se limita al propósito del servicio y se gestiona con acceso restringido.</p><div class="trust-links"><a class="trust-link" href="/como-trabajamos/">Ver cómo trabajamos →</a></div></article>
<article class="trust-card" data-reveal><span class="trust-num font-datos">05</span><h3>Lo que recibe, por escrito.</h3><p>Cada página de servicio describe sus entregables. Por ejemplo, el Diagnóstico entrega informe ejecutivo, hallazgos priorizados, recomendaciones aplicables y hoja de ruta inicial. Y puede ver una muestra antes de contratar: un informe demostrativo con 5 hallazgos, prioridades y ruta de mejora, marcado como muestra, no como caso de un cliente real.</p><div class="trust-links"><a class="trust-link" href="/servicios/diagnostico-seguridad/">Ver el servicio →</a><a class="trust-link" href="/informe-demostrativo/">Ver la muestra →</a></div></article>
<article class="trust-card" data-reveal><span class="trust-num font-datos">06</span><h3>Empresa formal, trato directo.</h3><p>JEFQ Consultor es persona natural con matrícula mercantil registrada. Y el trabajo lo acompaña personalmente Jaime Forero, desde la valoración inicial hasta la presentación de resultados.</p><div class="trust-links"><a class="trust-link" href="/quien-soy/">Ver quién soy →</a></div></article>
</div>
<div class="trust-no" data-reveal><h3>Lo que NO hacemos</h3><ul><li>No inventamos testimonios ni clientes.</li><li>No prometemos 100% de seguridad.</li><li>No cobramos antes de valorar: la valoración inicial es gratuita y sin compromiso.</li><li>El chat no se hace pasar por Jaime: es un asistente virtual, y se presenta como tal.</li><li>No mostramos la muestra del informe como si fuera de un cliente real: cada tarjeta está marcada como muestra.</li></ul></div>
<div class="trust-cta" data-reveal><p>¿Empezamos por la valoración gratuita? 4 pasos, sin compromiso.</p><a class="button secondary" href="/valoracion/">Hacer la valoración en línea</a></div>
</div></section>
<section class="section contact" id="contacto"><div class="container contact-grid"><div data-reveal><span class="label">CONTACTO</span><h2>Conversemos sobre lo que necesita proteger</h2><p>La valoración inicial permite definir alcance, tiempos y una cotización proporcional.</p><div class="contact-data"><a href="/api/whatsapp?text=Hola%20Jaime%2C%20quiero%20informaci%C3%B3n%20sobre%20los%20servicios%20de%20JEFQ%20Consultor." data-wa-modal><small>WhatsApp</small><b>@JaimeByte</b></a><a href="/api/whatsapp?text=Hola%20Jaime%2C%20quiero%20informaci%C3%B3n%20sobre%20los%20servicios%20de%20JEFQ%20Consultor."><small>WhatsApp directo</small><b>Escribir ahora</b></a><a href="mailto:jefqconsultor@gmail.com"><small>Correo</small><b>jefqconsultor@gmail.com</b></a><div><small>Cobertura</small><b>Bogotá y toda Colombia</b></div></div></div>
<form class="contact-form" id="contact-form" data-reveal><div class="form-row"><label>Nombre<input name="nombre" required maxlength="80" autocomplete="name" /></label><label>Empresa<input name="empresa" maxlength="100" autocomplete="organization" /></label></div><div class="form-row"><label>Servicio<select name="servicio" required><option value="">Seleccione</option><option>Diagnóstico de seguridad</option><option>Pruebas autorizadas</option><option>Hardening de sistemas</option><option>Informes técnicos y ejecutivos</option><option>Simulacros de seguridad</option><option>Acompañamiento de remediación</option><option>Seguridad para IA</option></select></label><label>Número de activos<select name="activos" required><option value="">Seleccione</option><option>1 a 5</option><option>6 a 20</option><option>Más de 20</option><option>Por definir</option></select></label></div><label>Necesidad<textarea name="mensaje" rows="5" required maxlength="700" placeholder="Describa brevemente qué desea proteger o evaluar"></textarea>

</label><label class="consent"><input type="checkbox" required /><span>Acepto la <a href="/privacidad">política de privacidad</a>.</span></label><p class="data-safety-note"><strong>Proteja su información:</strong> no envíe contraseñas, códigos MFA, llaves, archivos confidenciales ni detalles explotables. El primer contacto solo debe describir la necesidad de forma general.</p>
        <button class="button primary full" type="submit">Contactar por WhatsApp</button><small>No almacenamos este formulario. El mensaje se prepara para que pueda revisarlo.</small></form></div></section>
<script define:vars={{ diagPrecio: precioDe("esencial") }}>
const f=document.querySelector('#contact-form');f?.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(f);const text=["Hola Jaime, quiero información sobre ciberseguridad.","",`Nombre: ${d.get('nombre')}`,`Empresa: ${d.get('empresa')||'No indicada'}`,`Servicio: ${d.get('servicio')}`,`Activos: ${d.get('activos')}`,`Necesidad: ${d.get('mensaje')}`].join('\n');if(window.JEFQ_wa){window.JEFQ_wa.open(text);}});
// R3b (2026-11-07): banda .scroll-cta RETIRADA — F4 opción E. Era el tercer
// duplicado de WhatsApp (header + píldora + banda) y el control que más
// viewport tapaba (61 px desktop / 90,1 px móvil, sin cierre). Con ella
// desaparece también el bug de reaparición `nearEnd` en el fondo móvil
// (el booleano único del IntersectionObserver ya no existe). WhatsApp
// sigue por la píldora persistente + CTA del header; el chatbot, por el
// fab + teaser (ver AsistenteIA.astro).
// Mini-calculadora de costo de inactividad
(function(){var inp=document.getElementById('calc-monthly'),btn=document.getElementById('calc-btn'),res=document.getElementById('calc-result');if(!inp||!btn||!res)return;var DIAG=diagPrecio;
function fmt(n){return '$'+Math.round(n).toLocaleString('es-CO');}
function calc(){var m=parseFloat(String(inp.value).replace(/[^\d.]/g,''))||0;if(m<=0){res.hidden=true;return;}var day=m/30;document.getElementById('calc-day').textContent=fmt(day);document.getElementById('calc-loss-val').textContent=fmt(day);
var mx=Math.max(day,DIAG);document.getElementById('calc-fill-loss').style.width=Math.max(4,(day/mx*100))+'%';document.getElementById('calc-fill-diag').style.width=Math.max(4,(DIAG/mx*100))+'%';res.hidden=false;}
btn.addEventListener('click',calc);inp.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();calc();}});})();
</script>

<script>
// Partículas del encabezado: red luminosa de puntos que derivan, se
// enlazan con líneas de luz y reaccionan al cursor. Respeta
// prefers-reduced-motion y se pausa fuera de pantalla.
(function(){
  var c=document.getElementById('hero-particles'); if(!c) return;
  var ctx=c.getContext('2d'), W=0,H=0, pts=[], mouse={x:-9999,y:-9999}, visible=true;
  var COLORS=['127,196,232','255,255,255','255,120,140'];
  function size(){ var r=c.parentElement.getBoundingClientRect(); W=c.width=r.width; H=c.height=r.height;
    var n=Math.max(60, Math.min(190, Math.floor(W*H/8000))); pts=[];
    for(var i=0;i<n;i++) pts.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.5,vy:(Math.random()-.5)*.5,r:Math.random()*2.4+.8,col:COLORS[i%3],ph:Math.random()*6.28});
  }
  size(); window.addEventListener('resize', size); window.addEventListener('load', size); setTimeout(size, 300);
  c.parentElement.addEventListener('mousemove', function(e){ var r=c.getBoundingClientRect(); mouse.x=e.clientX-r.left; mouse.y=e.clientY-r.top; });
  c.parentElement.addEventListener('mouseleave', function(){ mouse.x=-9999; mouse.y=-9999; });
  new IntersectionObserver(function(es){ visible=es[0].isIntersecting; }).observe(c);
  var t=0;
  (function tick(){
    requestAnimationFrame(tick);
    if(!visible) return;
    t+=.016;
    ctx.clearRect(0,0,W,H);
    for(var i=0;i<pts.length;i++){ var p=pts[i];
      var dx=p.x-mouse.x, dy=p.y-mouse.y, d2=dx*dx+dy*dy;
      if(d2<22500){ var d=Math.sqrt(d2)||1; p.x+=dx/d*1.6; p.y+=dy/d*1.6; }
      p.x+=p.vx; p.y+=p.vy;
      if(p.x<0||p.x>W)p.vx*=-1; if(p.y<0||p.y>H)p.vy*=-1;
      var tw=.65+.35*Math.sin(t*2+p.ph);
      ctx.beginPath(); ctx.arc(p.x,p.y,p.r*tw,0,6.2832);
      ctx.fillStyle='rgba('+p.col+','+(0.9*tw)+')';
      ctx.shadowColor='rgba('+p.col+',.8)'; ctx.shadowBlur=8*tw; ctx.fill(); ctx.shadowBlur=0;
    }
    for(var a=0;a<pts.length;a++) for(var b=a+1;b<pts.length;b++){
      var p1=pts[a],p2=pts[b],ddx=p1.x-p2.x,ddy=p1.y-p2.y,dd=ddx*ddx+ddy*ddy;
      if(dd<16900){ ctx.beginPath(); ctx.moveTo(p1.x,p1.y); ctx.lineTo(p2.x,p2.y); ctx.strokeStyle='rgba(127,196,232,'+(0.35*(1-dd/16900))+')'; ctx.lineWidth=1; ctx.stroke(); }
    }
    if(mouse.x>-100){ for(var m=0;m<pts.length;m++){ var pm=pts[m],mx=pm.x-mouse.x,my=pm.y-mouse.y,md=mx*mx+my*my;
      if(md<22500){ ctx.beginPath(); ctx.moveTo(pm.x,pm.y); ctx.lineTo(mouse.x,mouse.y); ctx.strokeStyle='rgba(255,255,255,'+(0.3*(1-md/22500))+')'; ctx.stroke(); } } }
  })();
})();
</script>
</Layout>
