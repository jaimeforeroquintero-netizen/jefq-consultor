---
import Layout from "../layouts/Layout.astro";
import { findings, totalActions, counts, NIVEL_GENERAL_DEMO } from "../data/informe-demostrativo";
import RemediationTimeline from "../components/RemediationTimeline.astro";
import HallazgoAnatomia from "../components/HallazgoAnatomia.astro";
---

<Layout title="Informe demostrativo de ciberseguridad | JEFQ Consultor" description="Muestra ilustrativa de un informe JEFQ con cinco hallazgos coherentes, prioridades, evidencias redactadas y ruta de mejora.">
  <main class="report-v4">
    <section class="report-hero-v4">
      <div class="container">
        <span class="sample-seal">MUESTRA ILUSTRATIVA · NO CORRESPONDE A UN CLIENTE REAL</span>
        <p class="section-label">INFORME DEMOSTRATIVO V4</p>
        <h1>Conozca el nivel de claridad que puede recibir</h1>
        <p class="report-lead">Esta muestra explica cómo pueden organizarse los hallazgos, las prioridades y una ruta de mejora. Las cifras, evidencias y situaciones fueron creadas únicamente para demostrar la estructura del entregable.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="report-metrics-v4">
          <article><span>Nivel general</span><strong>{NIVEL_GENERAL_DEMO}</strong></article>
          <article><span>Hallazgos</span><strong>{findings.length}</strong></article>
          <article><span>Prioridad alta</span><strong>{counts.high}</strong></article>
          <article><span>Acciones</span><strong>{totalActions}</strong></article>
        </div>

        <article class="executive-conclusion-v4">
          <p class="section-label">CONCLUSIÓN EJECUTIVA ILUSTRATIVA</p>
          <h2>La prioridad inicial se concentra en accesos y exposición externa</h2>
          <p>La muestra presenta oportunidades de mejora en control de privilegios, servicios publicados, consistencia de configuración, autenticación y recuperación. La secuencia recomendada comienza por reducir accesos y exposición innecesaria, continúa con la estandarización y finaliza con la validación periódica de controles.</p>
        </article>

        <div class="severity-scale-v4" aria-label="Escala ilustrativa de prioridad">
          <article class="high"><strong>Alta</strong><span>Impacto relevante o exposición que requiere atención prioritaria.</span></article>
          <article class="medium"><strong>Media</strong><span>Debilidad que conviene planificar y corregir en el corto plazo.</span></article>
          <article class="low"><strong>Baja</strong><span>Oportunidad de mejora o control que debe formalizarse.</span></article>
        </div>
      </div>
    </section>

    <section class="section dark-section">
      <div class="container">
        <header class="section-header">
          <span>HALLAZGOS ILUSTRATIVOS</span>
          <h2>Cinco ejemplos coherentes con el resumen ejecutivo</h2>
          <p>Cada tarjeta está marcada como muestra y no representa evidencia de un cliente real.</p>
        </header>
        <div class="findings-grid-v4">
          {findings.map((finding) => (
            <article class="finding-v4">
              <div class="finding-top-v4"><span>{finding.id} · MUESTRA</span><strong class:list={[finding.priority.toLowerCase(), "priority-chip-v4"]}>{finding.priority}</strong></div>
              <p class="finding-area-v4">{finding.area}</p>
              <h3>Situación observada</h3><p>{finding.observation}</p>
              <h3>Impacto potencial</h3><p>{finding.impact}</p>
              <h3>Evidencia redactada</h3><p>{finding.evidence}</p>
              <h3>Acción recomendada</h3><p>{finding.recommendation}</p>
              <h3>Beneficio esperado</h3><p>{finding.benefit}</p>
              <small>{finding.actions} acciones asociadas en esta muestra.</small>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <header class="section-header"><span>HALLAZGO COMPLETO</span><h2>Un hallazgo, desarrollado de principio a fin</h2><p>La tabla resume cinco hallazgos; esta ficha muestra uno completo, con los nueve campos que lleva cada hallazgo del informe.</p></header>
        <HallazgoAnatomia />
      </div>
    </section>

    <section class="section">
      <div class="container">
        <header class="section-header"><span>RUTA DE MEJORA</span><h2>Una secuencia clara para avanzar</h2></header>
        <RemediationTimeline />

        <div class="report-cta-v4">
          <div><p class="section-label">SIGUIENTE PASO</p><h2>Defina un alcance adecuado para su organización</h2><p>La valoración inicial permite comprender la necesidad sin solicitar contraseñas ni información sensible.</p></div>
          <div class="report-actions-v4"><a class="button primary" href="/valoracion">Solicitar valoración</a><a class="button secondary" href="/como-trabajamos">Ver autorización y alcance</a></div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <header class="section-header"><span>PARA PRESENTAR A DIRECCIÓN</span><h2>Presente la necesidad con claridad</h2><p>Una guía breve para explicar a dirección por qué conviene valorar riesgos antes de aprobar cambios o inversiones.</p></header>
        <div class="landing-two-columns">
          <article class="commercial-doc">
            <h2>Resumen para dirección</h2>
            <p>La propuesta busca conocer la exposición actual, priorizar mejoras y evitar decisiones aisladas. La valoración inicial no incluye acceso a sistemas ni ejecución de pruebas.</p>
            <h3>Qué se solicita aprobar</h3>
            <ul><li>Una conversación inicial.</li><li>La definición de activos y objetivos.</li><li>La preparación de una propuesta con alcance, límites y entregables.</li></ul>
            <h3>Qué no se solicita todavía</h3>
            <ul><li>Contraseñas o secretos.</li><li>Acceso remoto.</li><li>Intervenciones técnicas.</li><li>Cambios en producción.</li></ul>
          </article>
          <article class="commercial-card featured">
            <span class="section-label">VERSIÓN BREVE</span>
            <h2>Mensaje sugerido</h2>
            <p>“Proponemos realizar una valoración inicial para identificar si existe un alcance de seguridad adecuado. Esta etapa no requiere compartir credenciales ni autoriza pruebas. Su resultado será una propuesta con prioridades, condiciones y entregables para decidir con información suficiente.”</p>
            <div class="commercial-actions"><a class="button primary" href="/valoracion">Solicitar valoración</a></div>
          </article>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
.report-hero-v4{padding:100px 0 70px;background:radial-gradient(circle at 80% 20%,rgba(41,206,186,.2),transparent 35%),linear-gradient(145deg,#081828,#102d43);border-bottom:1px solid rgba(130,190,215,.22)}
.report-hero-v4 h1{max-width:850px;margin:14px 0 18px;font-size:clamp(2.7rem,7vw,5.7rem);line-height:1;letter-spacing:-.055em}.report-lead{max-width:850px;color:#cbe0ed;font-size:1.08rem}.sample-seal{display:inline-flex;padding:8px 12px;border:1px solid rgba(255,190,70,.55);border-radius:999px;color:#ffd17a;background:rgba(255,181,55,.09);font-size:.72rem;font-weight:900;letter-spacing:.08em}.report-metrics-v4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.report-metrics-v4 article{padding:24px;background:linear-gradient(145deg,rgba(17,54,81,.9),rgba(8,24,40,.95));border:1px solid rgba(93,190,215,.3);border-radius:18px}.report-metrics-v4 span,.report-metrics-v4 strong{display:block}.report-metrics-v4 span{color:#aec7d8;font-size:.78rem;text-transform:uppercase;letter-spacing:.07em}.report-metrics-v4 strong{margin-top:8px;color:#65e7cc;font-size:2rem}.executive-conclusion-v4{margin-top:22px;padding:30px;background:#f8fbfd;color:#0c2235;border-radius:20px;box-shadow:0 24px 70px rgba(0,0,0,.15)}.executive-conclusion-v4 h2{margin:8px 0 12px;font-size:clamp(1.7rem,4vw,2.6rem)}.executive-conclusion-v4 p:last-child{color:#405b6d}.severity-scale-v4{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px}.severity-scale-v4 article{padding:20px;border-radius:16px;background:rgba(16,43,65,.72);border:1px solid rgba(130,190,215,.22)}.severity-scale-v4 strong,.severity-scale-v4 span{display:block}.severity-scale-v4 strong{font-size:1.15rem}.severity-scale-v4 span{margin-top:6px;color:#acc4d4}.severity-scale-v4 .high strong{color:#ffbd69}.severity-scale-v4 .medium strong{color:#65e7cc}.severity-scale-v4 .low strong{color:#a8c9de}.findings-grid-v4{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.finding-v4{padding:27px;background:linear-gradient(155deg,rgba(15,46,70,.92),rgba(7,22,37,.98));border:1px solid rgba(111,185,213,.25);border-radius:20px}.finding-top-v4{display:flex;justify-content:space-between;gap:14px;align-items:center}.finding-top-v4>span{color:#8faabd;font-size:.72rem;font-weight:800;letter-spacing:.08em}.priority-chip-v4{padding:5px 9px;border-radius:999px;font-size:.72rem}.priority-chip-v4.alta{color:#2b1a00;background:#ffc166}.priority-chip-v4.media{color:#00271f;background:#65e7cc}.priority-chip-v4.baja{color:#08283a;background:#a8d8ef}.finding-area-v4{color:#65e7cc;font-weight:800}.finding-v4 h3{margin:18px 0 5px;font-size:.82rem;text-transform:uppercase;letter-spacing:.07em}.finding-v4 p{margin:0;color:#bfd1dd}.finding-v4 small{display:block;margin-top:20px;padding-top:14px;color:#8faabd;border-top:1px solid rgba(130,190,215,.18)}.report-cta-v4{display:grid;grid-template-columns:1.4fr .6fr;gap:28px;align-items:center;margin-top:28px;padding:30px;border:1px solid rgba(255,190,70,.4);background:linear-gradient(135deg,rgba(255,177,51,.11),rgba(40,205,186,.08));border-radius:20px}.report-cta-v4 h2{margin:8px 0}.report-cta-v4 p{color:#b9cfdb}.report-actions-v4{display:grid;gap:10px}@media(max-width:800px){.report-metrics-v4,.severity-scale-v4,.findings-grid-v4,.report-cta-v4{grid-template-columns:1fr}.report-hero-v4{padding:75px 0 55px}}
</style>