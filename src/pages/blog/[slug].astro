---
import Layout from "../../layouts/Layout.astro";
import { blogPosts } from "../../data/growth-content";
export function getStaticPaths(){return blogPosts.map(post=>({params:{slug:post.slug},props:{post}}));}
const { post } = Astro.props;
---
<Layout title={post.title} description={post.description}>
<article class="article"><header><div class="container narrow"><span>{post.category} · {post.readingTime}</span><h1>{post.title}</h1><p>{post.intro}</p></div></header><div class="container narrow body">{post.sections.map(section=><section><h2>{section.heading}</h2>{section.paragraphs?.map(p=><p>{p}</p>)}{section.bullets&&<ul>{section.bullets.map(item=><li>{item}</li>)}</ul>}</section>)}<aside><h2>¿Necesita una valoración proporcional?</h2><p>Definimos alcance, activos y objetivos antes de proponer un servicio.</p><a href="/api/whatsapp?text=Hola%20Jaime%2C%20quiero%20una%20valoraci%C3%B3n%20de%20ciberseguridad." data-wa-modal data-wa-message="Hola Jaime, quiero una valoración de ciberseguridad.">Contactar por WhatsApp</a></aside></div></article>

  <!-- JEFQ-SEO-AUTHORITY-CONTEXT -->
  <section class="section dark-section">
    <div class="container authority-cta">
      <div>
        <span class="section-label">RECURSOS PARA DECIDIR</span>
        <h2>Profundice antes de solicitar una valoración</h2>
        <p>Consulte el informe demostrativo, la metodología, las preguntas frecuentes y el checklist de seguridad para PYMES.</p>
      </div>
      <div class="authority-actions">
        <a class="button primary" href="/recursos">Ver recursos</a>
        <a class="button secondary" href="/valoracion">Solicitar valoración</a>
      </div>
    </div>
  </section>
</Layout>
<style>
.article header{padding:7rem 0 4rem;background:linear-gradient(180deg,rgba(16,20,27,.9),transparent)}.narrow{max-width:820px}.article header span{color:#57C7A3;font-size:.78rem;font-weight:800}.article h1{font-size:clamp(2.5rem,6vw,4.8rem);line-height:1.02;letter-spacing:-.05em}.article header p,.body p,.body li{color:#C9C2B4}.body{padding:2rem 0 7rem}.body section{padding:1.4rem 0;border-bottom:1px solid rgba(42,51,66,.18)}.body h2{font-size:1.6rem}.body li{margin:.65rem 0}.body aside{margin-top:3rem;padding:2rem;background:#10141B;border:1px solid rgba(87,199,163,.3);border-radius:20px}.body aside a{display:inline-flex;padding:.8rem 1.1rem;color:#14100A;background:linear-gradient(135deg,#57C7A3,#57C7A3);border-radius:10px;font-weight:850}
.muestra-cierre h3{color:var(--bone)}

.growth-hero span,.growth-card>span,.article header span{color:var(--emerald)}
.growth-hero p,.growth-card p,.article header p,.body p,.body li{color:var(--muted)}
.growth-card,.body aside{background:var(--surface);border-color:var(--line)}
.growth-card a{color:var(--gold)}
.body aside a{background:var(--gold);color:var(--on-gold)}
</style>