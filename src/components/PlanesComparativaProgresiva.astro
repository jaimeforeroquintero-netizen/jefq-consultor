---
// COMPARATIVA PROGRESIVA 5×3 (+1 FILA DE EXCLUSIVIDAD) — R3 PUBLICADA (2026-11-07).
// ---------------------------------------------------------------------------
// ESTADO: conectada en src/pages/index.astro en lugar de PlanesComparativa.astro
// (17 filas ✓/—, ELIMINADA en R3: la tabla vieja era redundante — 17 ✓, 34 —,
// 0 filas compartidas — y mostraba un falso negativo en Integral).
// Rebase R3 sobre main a315ef5 (R2 desplegado); HEAD histórico 2173118.
//
// RESUELTO 2026-11-07 16:04 (decisión de Jaime, opción B): Seguridad
// Integral SÍ incluye informe — técnico Y ejecutivo — como UN ÚNICO
// INFORME INTEGRADO: sección ejecutiva + desarrollo técnico en un solo
// documento. Estructura decidida (A): un solo informe integrado, NO dos
// documentos separados. Fundamento: (1) preferencia expresa de Jaime;
// (2) el servicio «Informes técnicos y ejecutivos» del propio sitio
// (services.ts) ya define el entregable como UNO solo — «Documento
// ejecutivo» + «Anexo técnico» (+ Matriz de hallazgos + Sesión de
// presentación) —, por lo que dos documentos contradirían esa definición
// y crearían riesgo de divergencia entre versiones; (3) la progresión
// Esencial «Ejecutivo» → Pyme «Técnico y ejecutivo» → Integral «Técnico
// y ejecutivo» es el mismo tipo de entregable con mayor alcance y
// profundidad, no un documento adicional; (4) no hay precio ni evidencia
// de un segundo documento, y la separación de audiencias ya existe dentro
// del informe (sección ejecutiva para responsables, cuerpo técnico para
// quienes remedian). Ninguna ventaja material demostrable de dos
// documentos: no se adopta la opción B-documentos.
// CORRECCIÓN CANÓNICA R3: el `incluye` de Integral en src/data/precios.ts
// ahora contiene «Informe técnico y ejecutivo» (antes ausente: ese era el
// falso negativo). Solo ese valor; demás entregables y precios SIN CAMBIO.
// La tarjeta de Integral gana esa línea en su lista (7 ítems): es la
// corrección misma, no un entregable nuevo.
//
// ESTRUCTURA (6 filas × 3 planes): 5 dimensiones progresivas (Alcance,
// Informe, Ruta de mejora, Seguimiento, Evaluación) + 1 fila «Solo en
// Integral» (Hardening priorizado + Evidencias). Las 5 dimensiones cubren
// 15/17 filas de la tabla vieja; los 2 entregables exclusivos de Integral
// no caben en ninguna dimensión y viven en la fila de exclusividad, porque
// la pregunta «¿qué tiene solo Integral?» es material para decidir y las
// tarjetas no la responden de forma inmediata (listan ítems por plan sin
// marcar exclusividad). «5×3» nombra las cinco dimensiones; la tabla
// publicada es 6×3 por esa fila, no 17 filas disjuntas.
//
// FUENTE DE LOS VALORES: textos existentes de src/data/precios.ts. Nada
// inventado: cada celda es una cadena literal de `incluye` o una
// reformulación mínima de ella. Los precios del encabezado se leen en
// vivo de precios.ts (precioDe), como la tabla anterior.
// ---------------------------------------------------------------------------
import { PRECIOS, precioDe, formatearCOP } from "../data/precios";

const planes = PRECIOS.filter((p) => p.producto);

// placeholder: true = celda SIN dato verificado; NO renderizar como hecho.
type Celda = { valor: string; placeholder?: boolean; pregunta?: string };
type Dimension = { nombre: string; celdas: [Celda, Celda, Celda] };

const DIMENSIONES: Dimension[] = [
  {
    nombre: "Alcance",
    celdas: [
      { valor: "Hasta 3 equipos" },
      { valor: "Alcance autorizado · hasta 10 activos" },
      { valor: "Alcance personalizado" },
    ],
  },
  {
    nombre: "Informe",
    celdas: [
      { valor: "Ejecutivo" },
      { valor: "Técnico y ejecutivo" },
      // RESUELTO 2026-11-07 16:04 (Jaime, opción B): informe técnico y
      // ejecutivo como UN ÚNICO informe integrado (sección ejecutiva +
      // desarrollo técnico). Ver cabecera del archivo.
      { valor: "Técnico y ejecutivo" },
    ],
  },
  {
    nombre: "Ruta de mejora",
    celdas: [
      { valor: "Riesgos prioritarios" },
      { valor: "Plan de remediación" },
      { valor: "Plan por etapas" },
    ],
  },
  {
    nombre: "Seguimiento",
    celdas: [
      { valor: "Sesión de resultados" },
      { valor: "Acompañamiento" },
      { valor: "Dos seguimientos" },
    ],
  },
  {
    nombre: "Evaluación",
    celdas: [
      { valor: "Reunión remota" },
      { valor: "Revisión de configuraciones" },
      { valor: "Evaluación autorizada" },
    ],
  },
  {
    nombre: "Solo en Integral",
    celdas: [
      { valor: "No incluido en este plan" },
      { valor: "No incluido en este plan" },
      { valor: "Hardening priorizado + evidencias" },
    ],
  },
];

// Inventario de placeholders internos (para el informe R3; no se publica):
//   0 placeholders. INFORME-INTEGRAL RESUELTO 2026-11-07 16:04 (Jaime,
//   opción B: informe técnico y ejecutivo, único informe integrado) y
//   corregido en la fuente canónica (precios.ts: Integral incluye
//   «Informe técnico y ejecutivo»). Todo son cadenas literales de precios.ts.
const PLACEHOLDERS = DIMENSIONES.flatMap((d, i) =>
  d.celdas.map((c, j) => ({ ...c, dimension: d.nombre, plan: planes[j]?.nombre })).filter((c) => c.placeholder),
);
---

<div class="planes-comparativa-progresiva" data-estado="publicada" data-placeholders={PLACEHOLDERS.length}>
  <!-- R3: comparativa progresiva publicada (sustituye a PlanesComparativa,
       17 filas ✓/—, eliminada). INFORME-INTEGRAL resuelto 2026-11-07
       16:04 por Jaime (opción B, único informe integrado); la fuente
       canónica precios.ts ya contiene «Informe técnico y ejecutivo» en
       Integral. 5 dimensiones + 1 fila «Solo en Integral» (ver cabecera). -->
  <header class="comparativa-progresiva-head">
    <p class="section-label">COMPARAR PLANES</p>
    <h3>Qué mejora al subir de plan</h3>
    <p>Cinco dimensiones progresivas y una fila de exclusividad, con valores en vez de ✓/—.</p>
  </header>
  <div class="comparativa-progresiva-tabla-wrap">
    <table class="comparativa-progresiva-tabla">
      <caption>Comparativa progresiva por dimensión</caption>
      <thead>
        <tr>
          <th scope="col">Dimensión</th>
          {planes.map((p) => (
            <th scope="col">{p.nombre}<span>Desde {formatearCOP(precioDe(p.id))}</span></th>
          ))}
        </tr>
      </thead>
      <tbody>
        {DIMENSIONES.map((d) => (
          <tr>
            <th scope="row">{d.nombre}</th>
            {d.celdas.map((c) => (
              <td class:list={[{ "celda-placeholder": c.placeholder }]} data-pregunta={c.pregunta ?? undefined}>{c.valor}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="comparativa-progresiva-apilado" aria-label="Comparativa progresiva por plan">
    {planes.map((p, j) => (
      <article class="comparativa-progresiva-plan">
        <h4>{p.nombre}</h4>
        <p class="comparativa-progresiva-precio">Desde {formatearCOP(precioDe(p.id))}</p>
        <dl>
          {DIMENSIONES.map((d) => (
            <div>
              <dt>{d.nombre}</dt>
              <dd class:list={[{ "celda-placeholder": d.celdas[j].placeholder }]} data-pregunta={d.celdas[j].pregunta ?? undefined}>{d.celdas[j].valor}</dd>
            </div>
          ))}
        </dl>
      </article>
    ))}
  </div>
  <p class="comparativa-progresiva-nota">Valores de entrada sujetos al alcance acordado. Consultoría remota desde {formatearCOP(precioDe("consultoria-hora"))} COP por hora. Hardening de sistemas desde {formatearCOP(precioDe("hardening"))} COP.</p>
</div>

<style>
.planes-comparativa-progresiva{margin-top:34px;padding:28px;border:1px solid #d7e2ea;border-radius:20px;background:#fff;text-align:left}
.comparativa-progresiva-head h3{margin:10px 0 8px;font-size:clamp(1.4rem,3vw,1.9rem);color:#0d2840}
.comparativa-progresiva-head p{margin:0;color:#40566b;max-width:62ch}
.comparativa-progresiva-tabla-wrap{overflow-x:auto;margin-top:18px}
.comparativa-progresiva-tabla{width:100%;border-collapse:collapse;min-width:560px}
.comparativa-progresiva-tabla caption{text-align:left;padding:10px 0;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:#40566b}
.comparativa-progresiva-tabla th,.comparativa-progresiva-tabla td{padding:11px 10px;border-top:1px solid #d7e2ea;vertical-align:top;text-align:left;font-size:.95rem;color:#22394d}
.comparativa-progresiva-tabla thead th{border-top:0;color:#0d2840;font-size:.95rem}
.comparativa-progresiva-tabla thead th span{display:block;margin-top:4px;font-size:.82rem;font-weight:700;color:#0b6e66}
.comparativa-progresiva-tabla tbody th{font-weight:700}
.comparativa-progresiva-tabla tbody th:first-child{width:22%}
/* Placeholder interno: visible SOLO si el componente se renderiza en un
   entorno de revisión; marca el dato sin resolver, no un hecho. */
.celda-placeholder{color:#8a6d00 !important;font-style:italic;background:#fdf6e0}
.comparativa-progresiva-apilado{display:none}
.comparativa-progresiva-nota{margin:18px 0 0;color:#40566b;font-size:.92rem}
@media(max-width:800px){
  .comparativa-progresiva-tabla-wrap{display:none}
  .comparativa-progresiva-apilado{display:grid;gap:14px;margin-top:18px}
  .comparativa-progresiva-plan{padding:20px;border:1px solid #d7e2ea;border-radius:16px;background:#f8fbfd}
  .comparativa-progresiva-plan h4{margin:0;color:#0d2840;font-size:1.15rem}
  .comparativa-progresiva-precio{margin:6px 0 12px;color:#0b6e66;font-weight:800}
  .comparativa-progresiva-plan dl{margin:0;display:grid;gap:10px}
  .comparativa-progresiva-plan dl div{display:grid;gap:2px}
  .comparativa-progresiva-plan dt{font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:#40566b}
  .comparativa-progresiva-plan dd{margin:0;color:#22394d;font-size:.95rem}
  .planes-comparativa-progresiva{padding:20px}
}
</style>
