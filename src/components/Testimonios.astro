---
/**
 * Testimonios.astro — Sección de prueba social para JEFQ Consultor.
 *
 * ESTADO: componente listo pero INTENCIONALMENTE sin incluir en ninguna página.
 * No se publican testimonios hasta contar con material real y autorizado.
 *
 * PARA ACTIVARLO (cuando Jaime lo indique):
 * 1. Conseguir 2–3 testimonios reales: nombre + cargo + empresa + frase textual,
 *    con autorización escrita del cliente para publicarlos.
 * 2. Importar en la página deseada (p. ej. index.astro):
 *      import Testimonios from "../components/Testimonios.astro";
 *    y renderizar:
 *      <Testimonios testimonios={[
 *        { nombre: "Nombre Apellido", cargo: "Gerente", empresa: "Empresa S.A.S.", texto: "Frase textual del cliente." },
 *      ]} />
 * 3. Si la sección queda vacía (sin testimonios), NO se renderiza nada.
 *
 * REGLA: jamás inventar nombres, empresas ni frases. Sin material real, no se publica.
 */
interface Testimonio {
  nombre: string;
  cargo: string;
  empresa: string;
  texto: string;
}
interface Props {
  testimonios?: Testimonio[];
}
const { testimonios = [] } = Astro.props;
---
{testimonios.length > 0 && (
<section class="section testimonios" aria-label="Testimonios de clientes">
  <div class="container">
    <header class="section-head" data-reveal>
      <span>CONFIANZA</span>
      <h2>Lo que dicen quienes ya trabajaron con JEFQ</h2>
      <p>Testimonios reales de organizaciones atendidas, publicados con su autorización.</p>
    </header>
    <div class="testimonios-grid">
      {testimonios.map((t) => (
        <figure class="testimonio" data-reveal>
          <span class="testimonio-quote" aria-hidden="true">“</span>
          <blockquote>{t.texto}</blockquote>
          <figcaption>
            <b>{t.nombre}</b>
            <span>{t.cargo} · {t.empresa}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
)}
<style>
.testimonios-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:19px}
.testimonio{position:relative;margin:0;padding:30px 28px;background:linear-gradient(155deg,rgba(14,38,65,.84),rgba(5,17,31,.97));border:1px solid var(--line);border-radius:var(--radius);transition:transform .2s ease,border-color .2s ease}
.testimonio:hover{transform:translateY(-5px);border-color:rgba(35,215,255,.46)}
.testimonio-quote{position:absolute;top:14px;right:22px;font-size:3.2rem;line-height:1;color:rgba(35,215,255,.22);font-family:Georgia,serif}
.testimonio blockquote{margin:0 0 22px;color:#dbe7f2;font-size:1rem;line-height:1.65;font-style:italic}
.testimonio figcaption{border-top:1px solid var(--line);padding-top:16px}
.testimonio figcaption b{display:block;color:var(--text)}
.testimonio figcaption span{display:block;margin-top:3px;color:var(--muted);font-size:.83rem}
@media(max-width:900px){.testimonios-grid{grid-template-columns:1fr;max-width:560px;margin-inline:auto}}
</style>
