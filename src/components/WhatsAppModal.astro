---
// Contacto directo por WhatsApp (@JaimeByte).
// El número vive SOLO en la variable privada WHATSAPP_NUMBER de Vercel;
// /api/whatsapp redirige a wa.me sin exponerlo en el sitio ni en el repo.
// Uso declarativo: <a href="#" data-wa-modal data-wa-message="Mensaje opcional">…</a>
// Uso imperativo: window.JEFQ_wa.open("Mensaje opcional")
const DEFAULT_MSG = "Hola Jaime, quiero información sobre los servicios de JEFQ Consultor.";
---

<script define:vars={{ DEFAULT_MSG }}>
(function () {
  if (window.JEFQ_wa) return;

  function go(message) {
    var text = (message || DEFAULT_MSG).slice(0, 600);
    window.location.href = '/api/whatsapp?text=' + encodeURIComponent(text);
  }

  document.addEventListener('click', function (e) {
    var t = e.target && e.target.closest ? e.target.closest('[data-wa-modal]') : null;
    if (!t) return;
    e.preventDefault();
    go(t.getAttribute('data-wa-message') || '');
  });

  window.JEFQ_wa = { open: go, close: function () {} };
})();
</script>
