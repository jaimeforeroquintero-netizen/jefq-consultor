---
// DIAGRAMA DEL PROCESO (M3, candidato).
// Diagrama lineal reutilizable de los 4 pasos reales del método, con la
// numeración 01–04 y los textos VERBATIM de la home (#metodologia).
// Fuente única: este componente. La home y /como-trabajamos/ lo importan,
// así que el método no se duplica en dos versiones distintas.
// R2 (2026-11-07): /ciberseguridad-bogota/ también lo importa (antes
// duplicaba el mismo método a mano en `.process` inline). Prop `steps`
// opcional: solo para las 2 localizaciones verbatim de Bogotá (01 "de su
// empresa en Bogotá", 02 "por escrito"); sin ella rige el canónico.
// NO se tocaron los procesos propios de cada servicio (/servicios/[slug],
// render único ServiceProcess) ni RemediationTimeline.
const CANONICAL_STEPS = [
  ["01", "Conocer el contexto", "Objetivos, activos, restricciones y riesgos."],
  ["02", "Definir el alcance", "Autorización, límites y condiciones de ejecución."],
  ["03", "Evaluar con control", "Pruebas proporcionales y evidencia organizada."],
  ["04", "Entregar y acompañar", "Prioridades, remediación y seguimiento."],
];
const { candidato = false, steps = CANONICAL_STEPS } = Astro.props;
const HREFS = ["/valoracion", "/como-trabajamos", "/servicios/diagnostico-seguridad", "/informe-demostrativo"];
---

<div class="process-diagram">
  {candidato && <p class="diagram-candidato">CANDIDATO — NO PUBLICADO</p>}
  <ol class="diagram-steps">
    {steps.map(([n, t, d], i) => (
      <li>
        <a class="diagram-link" href={HREFS[i]}>
          <span class="diagram-num font-datos" aria-hidden="true">{n}</span>
          <h3>{t}</h3>
          <p>{d}</p>
          <span class="diagram-ver">Ver más →</span>
        </a>
      </li>
    ))}
  </ol>
</div>

<style>
.process-diagram{margin-top:8px}
.diagram-candidato{display:inline-block;margin:0 0 14px;padding:6px 12px;border:1px dashed #E06C5B;border-radius:999px;color:#E06C5B;background:#10141B;font-size:.72rem;font-weight:900;letter-spacing:.07em}
.diagram-steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:0}
.diagram-steps li{position:relative;padding:34px 18px 0}
.diagram-steps li::before{content:"";position:absolute;top:15px;left:0;right:0;height:2px;background:#10141B}
.diagram-steps li:first-child::before{left:18px}
.diagram-steps li:last-child::before{right:calc(100% - 18px)}
.diagram-steps li::after{content:"›";position:absolute;top:4px;right:-4px;font-size:1.3rem;font-weight:900;color:#57C7A3}
.diagram-steps li:last-child::after{display:none}
.diagram-num{position:absolute;top:0;left:18px;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#57C7A3;color:#F3EDE2 !important;font-size:.82rem;font-weight:900;letter-spacing:.02em}
.diagram-steps h3{margin:0 0 6px;font-size:1.08rem;color:#C9C2B4}
.diagram-steps p{margin:0;color:#C9C2B4;font-size:.95rem}
@media(max-width:800px){
  .diagram-steps{grid-template-columns:1fr}
  .diagram-steps li{padding:0 0 26px 52px}
  .diagram-steps li::before{top:0;bottom:0;left:15px;right:auto;width:2px;height:auto}
  .diagram-steps li:first-child::before{left:15px;top:32px}
  .diagram-steps li:last-child::before{right:auto;bottom:auto;height:0}
  .diagram-steps li::after{content:"›";top:auto;bottom:2px;left:9px;right:auto;transform:rotate(90deg)}
  .diagram-steps li:last-child::after{display:none}
  .diagram-num{left:0;top:0}
}

.diagram-steps li::before,.timeline-steps li::before{background:var(--line)}
.diagram-steps li::after,.timeline-steps li::after{color:var(--emerald)}
.diagram-num,.timeline-num{background:var(--gold);color:var(--on-gold) !important}
.timeline-steps li:nth-child(2) .timeline-num{background:var(--emerald);color:var(--on-gold)}
.timeline-steps li:nth-child(3) .timeline-num{background:var(--raised);color:var(--bone)}
.diagram-steps h3,.timeline-steps h3{color:var(--bone)}
.diagram-steps p,.timeline-desc{color:var(--muted)}
.timeline-phase{color:var(--emerald)}
.diagram-candidato{color:var(--bone);background:var(--surface);border-color:var(--risk)}
.timeline-seal{color:var(--gold);background:rgba(216,162,74,.12);border-color:var(--gold)}
.diagram-link{display:block;text-decoration:none;color:inherit}
.diagram-ver{display:inline-block;margin-top:10px;color:#C8102E;font-size:.85rem;font-weight:800}
.diagram-link:hover h3{color:#C8102E}
.diagram-link:hover .diagram-ver{text-decoration:underline}
</style>
