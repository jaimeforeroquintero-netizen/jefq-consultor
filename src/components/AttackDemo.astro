---
// Demo interactiva: caso simulado de phishing dentro de una pantalla de PC con Gmail.
// 6 pasos: el ataque avanza (rojo) y la defensa JEFQ responde (verde).
// Controles manuales: play/pausa, anterior, siguiente, reinicio y línea de tiempo.
// Simulación con fines educativos; nombres ficticios; sin detalles técnicos explotables.
// Sin JS se muestra la secuencia estática (también sirve al SEO).
const STEPS = [
  { side: "ataque", phase: "01 · SEÑUELO", name: "SEÑUELO", title: "Llega el correo falso",
    desc: "En la bandeja de Gmail aparece un correo que suplanta al \u201cBanco Meridiano\u201d: logo, tono urgente y un enlace para \u201cverificar la cuenta\u201d.",
    risk: 25 },
  { side: "ataque", phase: "02 · ENGAÑO", name: "ENGAÑO", title: "El empleado muerde el anzuelo",
    desc: "Lo abre: \u201csu cuenta ser\u00e1 suspendida en 12 horas\u201d. El bot\u00f3n \u201cVerificar mi cuenta\u201d no lleva al banco, lleva a una p\u00e1gina falsa.",
    risk: 55 },
  { side: "ataque", phase: "03 · INTRUSI\u00d3N", name: "INTRUSI\u00d3N", title: "La clave cae en manos del atacante",
    desc: "En la p\u00e1gina falsa el empleado ingresa su usuario y contrase\u00f1a. En ese instante, el atacante toma el control del correo corporativo.",
    risk: 85 },
  { side: "defensa", phase: "04 · DETECCI\u00d3N", name: "DETECCI\u00d3N", title: "JEFQ detecta lo an\u00f3malo",
    desc: "Inicio de sesi\u00f3n a las 3:12 a.m. desde una ubicaci\u00f3n desconocida y un dispositivo no reconocido. La alerta se genera en minutos.",
    risk: 70 },
  { side: "defensa", phase: "05 · CONTENCI\u00d3N", name: "CONTENCI\u00d3N", title: "Se corta el acceso al atacante",
    desc: "Sesiones revocadas, cuenta bloqueada y equipo aislado de la red. El atacante pierde el control antes de extraer informaci\u00f3n.",
    risk: 25 },
  { side: "defensa", phase: "06 · RECUPERACI\u00d3N", name: "RECUPERACI\u00d3N", title: "A operar, m\u00e1s fuertes",
    desc: "Claves restablecidas, doble verificaci\u00f3n activada e informe ejecutivo con lecciones claras para la gerencia.",
    risk: 5 },
];
---

<section class="section" id="demo">
  <div class="container">
    <header class="section-head" data-reveal>
      <span>CASO 01 · DEMO INTERACTIVA</span>
      <h2>Vea un ataque&hellip; y c&oacute;mo se contiene</h2>
      <p>Caso simulado de <b>phishing</b> dentro de una pantalla real: dele <b>play</b> y observe el ataque paso a paso, con su explicaci&oacute;n abajito.</p>
    </header>

    <div class="demo-player" id="demo-player" data-reveal data-steps={JSON.stringify(STEPS)}>
      <div class="monitor">
        <div class="monitor-screen" id="demo-screen" role="img" aria-label="Simulación de un ataque de phishing dentro de una pantalla de computador con Gmail">

          <!-- PASO 1: bandeja de Gmail -->
          <div class="view" data-view="0">
            <div class="gmail">
              <div class="g-top"><span class="g-burger"><i></i><i></i><i></i></span><span class="g-logo">Gmail</span><span class="g-search">Buscar en correo</span><span class="g-avatar">G</span></div>
              <div class="g-body">
                <div class="g-side">
                  <span class="g-compose">Redactar</span>
                  <span class="g-nav on"><i></i>Bandeja de entrada<b>3</b></span>
                  <span class="g-nav"><i></i>Destacados</span>
                  <span class="g-nav"><i></i>Enviados</span>
                </div>
                <div class="g-list">
                  <div class="g-row phish"><span class="g-av" style="background:#c0392b">B</span><span class="g-from">Banco Meridiano</span><span class="g-subj">Acci&oacute;n requerida: verifique su cuenta hoy</span><span class="g-time">3:04 a.m.</span><span class="g-tag">¡falso!</span></div>
                  <div class="g-row"><span class="g-av" style="background:#2e6da4">C</span><span class="g-from">Contabilidad</span><span class="g-subj">Factura marzo — pago a proveedores</span><span class="g-time">ayer</span></div>
                  <div class="g-row"><span class="g-av" style="background:#6a7f3f">L</span><span class="g-from">Laura G&oacute;mez</span><span class="g-subj">Re: cotizaci&oacute;n impresoras</span><span class="g-time">ayer</span></div>
                </div>
              </div>
            </div>
          </div>

          <!-- PASO 2: correo abierto -->
          <div class="view" data-view="1" hidden>
            <div class="gmail">
              <div class="g-top"><span class="g-burger"><i></i><i></i><i></i></span><span class="g-logo">Gmail</span><span class="g-search">Buscar en correo</span><span class="g-avatar">G</span></div>
              <div class="g-open">
                <p class="g-meta"><b>Banco Meridiano</b> &lt;notificaciones@banco-meridiano-seguro.com&gt;<br /><span>para m&iacute; · 3:04 a.m.</span></p>
                <h4>Acci&oacute;n requerida: su cuenta ser&aacute; suspendida</h4>
                <p>Estimado cliente:<br />Detectamos actividad inusual en su cuenta. Verifique su identidad en las pr&oacute;ximas <b>12 horas</b> o su acceso ser&aacute; bloqueado.</p>
                <span class="g-cta-fake">Verificar mi cuenta</span>
                <p class="g-hint">El remitente real no es el banco · el bot&oacute;n lleva a una p&aacute;gina falsa</p>
              </div>
            </div>
          </div>

          <!-- PASO 3: página falsa del banco -->
          <div class="view" data-view="2" hidden>
            <div class="fakebank">
              <div class="fb-url">banco-meridiano-seguro.com — <b>sitio falso</b></div>
              <div class="fb-card">
                <b class="fb-logo">Banco Meridiano</b><span class="fb-sub">Banca en l&iacute;nea</span>
                <label>Usuario<span class="fb-field">gerencia@empresa.com</span></label>
                <label>Clave<span class="fb-field">••••••••••</span></label>
                <span class="fb-btn">Ingresar</span>
                <p class="fb-warn">Aqu&iacute; el atacante captura la clave y entra al correo</p>
              </div>
            </div>
          </div>

          <!-- PASO 4: alerta JEFQ -->
          <div class="view" data-view="3" hidden>
            <div class="jefq-alert">
              <div class="ja-card">
                <span class="ja-badge">JEFQ · ALERTA DE SEGURIDAD</span>
                <h4>Sesi&oacute;n an&oacute;mala detectada</h4>
                <div class="ja-rows">
                  <div><small>ORIGEN</small><b>Bogot&aacute; → ubicaci&oacute;n desconocida</b></div>
                  <div><small>HORA</small><b>3:12 a.m.</b></div>
                  <div><small>DISPOSITIVO</small><b>No reconocido</b></div>
                </div>
                <p>Comportamiento fuera del patr&oacute;n habitual de la cuenta. Se recomienda contenci&oacute;n inmediata.</p>
              </div>
            </div>
          </div>

          <!-- PASO 5: contención -->
          <div class="view" data-view="4" hidden>
            <div class="jefq-alert">
              <div class="ja-card">
                <span class="ja-badge ok">JEFQ · CONTENCI&Oacute;N EN CURSO</span>
                <h4>Cortando el acceso al atacante</h4>
                <ul class="ja-check">
                  <li>Sesiones activas revocadas</li>
                  <li>Cuenta bloqueada y protegida</li>
                  <li>Equipo aislado de la red</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- PASO 6: recuperación -->
          <div class="view" data-view="5" hidden>
            <div class="jefq-alert">
              <div class="ja-card">
                <span class="ja-badge ok">JEFQ · INCIDENTE CONTENIDO</span>
                <div class="ja-big">11<small>minutos</small></div>
                <p>De la alerta a la contenci&oacute;n total.</p>
                <ul class="ja-check">
                  <li>Claves restablecidas</li>
                  <li>Doble verificaci&oacute;n activada</li>
                  <li>Informe ejecutivo para la gerencia</li>
                </ul>
              </div>
            </div>
          </div>

        </div>
        <div class="monitor-tag">pantalla simulada · caso ficticio con fines educativos</div>
      </div>
      <div class="monitor-stand"><i></i></div>

      <!-- Referencia del paso actual -->
      <div class="demo-caption" aria-live="polite">
        <span class="demo-side" id="demo-side">ATACANTE</span>
        <div class="demo-cap-text"><b id="demo-phase">01 · SEÑUELO</b><h3 id="demo-title">Llega el correo falso</h3><p id="demo-desc"></p></div>
      </div>

      <div class="demo-risk">
        <div class="demo-risk-head"><span>Nivel de riesgo</span><b id="demo-risk-val">25 / 100</b></div>
        <div class="demo-risk-bar"><i id="demo-risk-fill" class="lo" style="width:25%"></i></div>
      </div>

      <div class="demo-timeline" id="demo-timeline" role="tablist" aria-label="Pasos de la simulación">
        {STEPS.map((s, i) => (
          <button type="button" role="tab" data-step={i} aria-label={s.phase + ": " + s.title} aria-selected={i === 0 ? "true" : "false"} class={i === 0 ? "active" : ""}>
            <b>{String(i + 1).padStart(2, "0")}</b><span>{s.name}</span>
          </button>
        ))}
      </div>

      <div class="demo-controls">
        <button type="button" id="demo-prev" aria-label="Paso anterior">&#9664;</button>
        <button type="button" id="demo-play" aria-label="Reproducir">&#9654;</button>
        <button type="button" id="demo-next" aria-label="Paso siguiente">&#9654;&#9654;</button>
        <button type="button" id="demo-restart" aria-label="Reiniciar">&#8635;</button>
      </div>

      <noscript>
        <ol class="demo-static">
          {STEPS.map((s) => (
            <li><b>{s.phase}: {s.title}.</b> {s.desc}</li>
          ))}
        </ol>
      </noscript>

      <p class="demo-note">Simulaci&oacute;n con fines educativos. Nombres y empresas ficticios: no representa un incidente real ni ense&ntilde;a a ejecutar ataques.</p>
      <div class="demo-cta">
        <span>Sin detecci&oacute;n, un atacante act&uacute;a durante d&iacute;as. Con JEFQ, la respuesta llega en minutos.</span>
        <a class="button primary" href="/valoracion">Descubra su exposici&oacute;n real</a>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var player = document.getElementById('demo-player');
  if (!player) return;
  var steps = null;
  try { steps = JSON.parse(player.getAttribute('data-steps') || 'null'); } catch (e) { steps = null; }
  if (!steps || !steps.length) return;

  var views = Array.prototype.slice.call(document.querySelectorAll('#demo-screen .view'));
  var sideEl = document.getElementById('demo-side');
  var phaseEl = document.getElementById('demo-phase');
  var titleEl = document.getElementById('demo-title');
  var descEl = document.getElementById('demo-desc');
  var riskVal = document.getElementById('demo-risk-val');
  var riskFill = document.getElementById('demo-risk-fill');
  var dots = Array.prototype.slice.call(document.querySelectorAll('#demo-timeline button'));
  var btnPlay = document.getElementById('demo-play');
  var btnPrev = document.getElementById('demo-prev');
  var btnNext = document.getElementById('demo-next');
  var btnRestart = document.getElementById('demo-restart');

  var idx = 0, timer = null, playing = false;
  var STEP_MS = 5200;
  var ICON_PLAY = '▶', ICON_PAUSE = '❚❚';

  function render() {
    var s = steps[idx];
    views.forEach(function (v, i) { v.hidden = (i !== idx); });
    var atk = s.side === 'ataque';
    sideEl.textContent = atk ? 'ATACANTE' : 'DEFENSA JEFQ';
    sideEl.className = 'demo-side ' + (atk ? 'is-atk' : 'is-def');
    phaseEl.textContent = s.phase;
    titleEl.textContent = s.title;
    descEl.textContent = s.desc;
    riskVal.textContent = s.risk + ' / 100';
    riskFill.style.width = s.risk + '%';
    riskFill.className = s.risk >= 60 ? 'hi' : (s.risk >= 30 ? 'mid' : 'lo');
    dots.forEach(function (d, i) {
      d.classList.toggle('active', i === idx);
      d.classList.toggle('done', i < idx);
      d.setAttribute('aria-selected', i === idx ? 'true' : 'false');
    });
  }

  function tick() {
    idx = (idx + 1) % steps.length;
    render();
    timer = setTimeout(tick, STEP_MS);
  }
  function play() {
    if (playing) return;
    playing = true;
    btnPlay.textContent = ICON_PAUSE;
    btnPlay.setAttribute('aria-label', 'Pausar');
    timer = setTimeout(tick, STEP_MS);
  }
  function pause() {
    playing = false;
    if (timer) { clearTimeout(timer); timer = null; }
    btnPlay.textContent = ICON_PLAY;
    btnPlay.setAttribute('aria-label', 'Reproducir');
  }
  function go(i) {
    pause();
    idx = ((i % steps.length) + steps.length) % steps.length;
    render();
  }

  // Estado inicial: paso 1 visible, botón en ▶, sin autoplay.
  render();
  pause();

  btnPlay.addEventListener('click', function () { playing ? pause() : play(); });
  btnPrev.addEventListener('click', function () { go(idx - 1); });
  btnNext.addEventListener('click', function () { go(idx + 1); });
  btnRestart.addEventListener('click', function () { go(0); play(); });
  dots.forEach(function (d) {
    d.addEventListener('click', function () {
      go(parseInt(d.getAttribute('data-step'), 10));
    });
  });
})();
</script>
