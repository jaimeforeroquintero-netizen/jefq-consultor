  .g-subj{color:#5f6368;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .g-time{margin-left:auto;color:#9aa0a6;font-size:.72rem;white-space:nowrap}
  .g-row.phish{background:#fef3f2;box-shadow:inset 0 0 0 2px #e57373;animation:phishPulse 1.8s ease-in-out infinite}
  .g-tag{position:absolute;right:76px;top:50%;transform:translateY(-50%) rotate(-4deg);padding:2px 8px;background:#c5221f;color:#fff;border-radius:6px;font-size:.62rem;font-weight:800}
